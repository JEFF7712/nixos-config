# Harness spike (M4 Task 1): offline VM smoke check.
#
# Proves, inside a network-less nixosTest VM:
#   1. intentd's own workspace.init_workspace + render + write_generated work
#      from the nix-built package.
#   2. `nix build path:<ws>#nixosConfigurations.intentd.config.system.build.toplevel`
#      completes offline and reproduces the exact toplevel pre-seeded from the
#      outer eval (coherence via --override-input nixpkgs path:<seeded source>).
#   3. `nix-env --profile /nix/var/nix/profiles/system --set <closure>` plus
#      `<closure>/bin/switch-to-configuration test` activate the candidate, and
#      firefox lands on the new system PATH.
#
# Mechanics notes live in nix/SPIKE_FINDINGS.md.
{ self, nixpkgs }:
let
  system = "x86_64-linux";
  pkgs = nixpkgs.legacyPackages.${system};

  intentd = self.packages.${system}.intentd;
  # buildPythonApplication does not mark itself as a python module
  # (toPythonModule = x: x), so withPackages would silently drop it without
  # the explicit toPythonModule wrap (passthru-only; same store path).
  pythonEnv = pkgs.python312.withPackages (ps: [ (ps.toPythonModule intentd) ]);

  # Byte-identical to
  # render(DesiredState(apps=("firefox",)), load_catalog(), None).
  # Byte identity is stronger than needed (module semantics decide the drv),
  # but it keeps the coherence argument trivial.
  generated = pkgs.writeText "generated.nix" ''
    # Generated by intentd. Do not edit; manual changes block activation.

    { pkgs, lib, ... }:
    {
      environment.systemPackages = [
        pkgs.firefox
      ];
    }
  '';

  # The same nixosSystem call the workspace flake template makes, with the
  # same nixpkgs (this flake's locked input). Module *paths* differ from the
  # in-VM workspace copies, but module identity does not enter the drv, so
  # the toplevel is identical -- asserted in the testScript.
  candidate =
    (nixpkgs.lib.nixosSystem {
      system = "x86_64-linux";
      modules = [
        "${self}/src/intentd/flake_template/base.nix"
        # NOTE: must be the coerced string path, not the derivation itself. A
        # derivation passed as a module is treated as an inline module attrset,
        # and its `system = "x86_64-linux"` drv attribute collides with the
        # NixOS `system` option.
        "${generated}"
      ];
    }).config.system.build.toplevel;

  # switch-to-configuration on the candidate stops backdoor.service (the test
  # driver's shell; it is not in the candidate config and has no
  # X-StopOnRemoval=false). Running s-t-c from the backdoor shell would kill
  # it mid-flight together with the backdoor's cgroup. So: run via
  # systemd-run (own cgroup), report over the serial console (immune to the
  # backdoor dying), then switch back to the original test toplevel ($1) to
  # resurrect the backdoor.
  # Output discipline (learned the hard way): the candidate config enables
  # serial-getty@ttyS0, and agetty vhangup()s the tty on start, revoking any
  # long-lived fd (an `exec >/dev/ttyS0` here dies with EIO, and
  # switch-to-configuration-ng PANICS when println hits the revoked stdout,
  # which silently kills the restore switch). So: s-t-c output goes to a log
  # file, and every console marker opens /dev/ttyS0 freshly per write.
  switchScript = pkgs.writeShellScript "smoke-switch" ''
    set +e
    # Transient systemd-run units do NOT inherit the caller's PATH, and get
    # no usable default on NixOS: external commands (readlink, sleep) fail
    # silently while builtins keep working. Pin coreutils explicitly.
    PATH=${pkgs.coreutils}/bin
    log=/tmp/smoke-switch.log
    mark() {
      echo "$1" >>"$log"
      echo "$1" >/dev/ttyS0
    }
    sleep 2
    ${candidate}/bin/switch-to-configuration test >>"$log" 2>&1
    mark "SMOKE-SWITCH-RC=$?"
    if [ -x /run/current-system/sw/bin/firefox ]; then
      mark "SMOKE-FIREFOX=OK"
    else
      mark "SMOKE-FIREFOX=MISSING"
    fi
    mark "SMOKE-PROFILE=$(readlink -f /nix/var/nix/profiles/system)"
    "$1"/bin/switch-to-configuration test >>"$log" 2>&1
    rc=$?
    # The candidate window started serial-getty@{hvc0,ttyS0}; a leftover
    # getty/login still reading hvc0 races the resurrected backdoor shell
    # and garbles the driver protocol. Kill them and restart backdoor for a
    # clean channel, then signal the driver.
    /run/current-system/sw/bin/systemctl stop "serial-getty@hvc0.service" "serial-getty@ttyS0.service" >>"$log" 2>&1
    /run/current-system/sw/bin/systemctl restart backdoor.service >>"$log" 2>&1
    mark "SMOKE-RESTORE-RC=$rc"
  '';

  test = pkgs.testers.runNixOSTest {
    name = "vm-smoke";

    nodes.machine =
      { lib, ... }:
      {
        # Test nodes default system.switch.enable = false (a Hydra
        # optimization in nixos-test-base.nix); without this the restore
        # switch has no bin/switch-to-configuration and fails with 127.
        system.switch.enable = true;
        virtualisation = {
          memorySize = 4096;
          cores = 4;
          diskSize = 4096;
          writableStore = true;
          # Everything the offline in-VM eval/build needs: the nixpkgs
          # source (for evaluation) and the candidate toplevel closure (so
          # the in-VM build is a no-op substitution from the local store).
          # pythonEnv is referenced by absolute store path in the testScript
          # instead of environment.systemPackages: putting a python env into
          # the system path drags python's `doc` output into system-path (via
          # meta.outputsToInstall), and python3.12's sphinx doc build is
          # broken at this nixpkgs rev.
          additionalPaths = [
            nixpkgs.outPath
            candidate
            switchScript
            pythonEnv
          ];
        };
        nix.settings = {
          experimental-features = [
            "nix-command"
            "flakes"
          ];
          substituters = lib.mkForce [ ];
          flake-registry = "";
        };
      };

    testScript =
      { nodes, ... }:
      ''
        import re
        import select
        import time

        machine.start()
        machine.wait_for_unit("multi-user.target")

        # Package acceptance: import intentd, read the bundled catalog, and
        # confirm the flake_template resources shipped in the wheel.
        machine.succeed(
            "${pythonEnv}/bin/python3 -c \"from intentd.catalog import load_catalog; c = load_catalog(); assert 'firefox' in c\""
        )
        machine.succeed(
            "${pythonEnv}/bin/python3 -c \"from importlib import resources; t = resources.files('intentd').joinpath('flake_template'); assert t.joinpath('flake.nix').is_file() and t.joinpath('base.nix').is_file()\""
        )

        # Workspace init + render + write via intentd's own code paths.
        machine.succeed(
            "${pythonEnv}/bin/python3 -c \"from pathlib import Path; from intentd.workspace import init_workspace; init_workspace(Path('/var/lib/intentd/ws'))\""
        )
        machine.succeed(
            "${pythonEnv}/bin/python3 -c \"from pathlib import Path; from intentd.catalog import load_catalog; from intentd.render import render; from intentd.state import DesiredState; from intentd.workspace import write_generated; write_generated(Path('/var/lib/intentd/ws'), render(DesiredState(apps=('firefox',)), load_catalog(), None))\""
        )

        # Offline in-VM build of the workspace flake, nixpkgs pinned to the
        # pre-seeded source path. Must reproduce the pre-seeded toplevel.
        # The rev+lastModified query params are REQUIRED for coherence:
        # nixpkgs' lib.trivial.versionSuffix comes from the flake's own
        # sourceInfo (lib/flake-version-info.nix), so a bare path: input
        # evaluates to a different toplevel (…19700101.dirty).
        built = machine.succeed(
            "nix build --print-out-paths --no-link --no-write-lock-file"
            " --override-input nixpkgs 'path:${nixpkgs}?rev=${nixpkgs.rev}&lastModified=${toString nixpkgs.lastModified}'"
            " 'path:/var/lib/intentd/ws#nixosConfigurations.intentd.config.system.build.toplevel'",
            timeout=1800,
        ).strip()
        assert built == "${candidate}", f"coherence broken: {built} != ${candidate}"

        machine.succeed("nix-env --profile /nix/var/nix/profiles/system --set ${candidate}")
        # readlink -f: the profile is system -> system-1-link -> <closure>.
        prof0 = machine.succeed("readlink -f /nix/var/nix/profiles/system").strip()
        assert prof0 == "${candidate}", f"profile not set: {prof0}"

        # Activate out-of-band (see switchScript comment), watch the serial
        # console for the markers.
        machine.succeed(
            "systemd-run --unit=smoke-switch ${switchScript} ${nodes.machine.system.build.toplevel}"
        )
        machine.wait_for_console_text("SMOKE-RESTORE-RC=", timeout=600)

        # The restore switch started a fresh backdoor.service; its banner
        # ("Spawning backdoor root shell...") sits in the shell socket and
        # would corrupt the driver's base64 block protocol. Drain it.
        time.sleep(5)
        assert machine.shell
        while True:
            ready, _, _ = select.select([machine.shell], [], [], 2)
            if not ready:
                break
            junk = machine.shell.recv(4096)
            if not junk:
                break
            print(f"drained stale shell bytes: {junk!r}")

        # The marker/log file is authoritative (console delivery can race
        # getty churn); the console wait above is only synchronization.
        # NOTE: do not name a variable "log": the driver typechecks the
        # testScript and a global `log: AbstractLogger` already exists.
        switch_log = machine.succeed("cat /tmp/smoke-switch.log")
        print("---- smoke-switch.log ----")
        print(switch_log)
        print("--------------------------")

        switch_m = re.search(r"SMOKE-SWITCH-RC=(\d+)", switch_log)
        restore_m = re.search(r"SMOKE-RESTORE-RC=(\d+)", switch_log)
        assert switch_m and restore_m, "switch markers missing from log"
        switch_rc = int(switch_m.group(1))
        restore_rc = int(restore_m.group(1))
        print(f"switch-to-configuration test: candidate rc={switch_rc}, restore rc={restore_rc}")
        # Contract: 0 = clean, 4 = activation done but some unit action
        # failed/timed out (expected here: the candidate stops the test
        # backdoor and swaps gettys). Anything else is a real failure.
        assert switch_rc in (0, 4), f"unexpected switch rc {switch_rc}"
        assert restore_rc in (0, 4), f"unexpected restore rc {restore_rc}"
        assert "SMOKE-FIREFOX=OK" in switch_log, "firefox missing from candidate system PATH"
        assert "SMOKE-PROFILE=${candidate}" in switch_log, "system profile does not point at candidate"

        prof = machine.succeed("readlink -f /nix/var/nix/profiles/system").strip()
        assert prof == "${candidate}", f"profile moved: {prof}"
      '';
  };
in
{
  inherit
    test
    candidate
    pythonEnv
    generated
    switchScript
    ;
}
