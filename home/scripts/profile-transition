#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/profile-common"
TRANSITION_TARGET_FILE="$PROFILES_DIR/transition-target"
TRANSITION_VARIANT_FILE="$PROFILES_DIR/transition-variant"

usage() {
  echo "Usage: profile-transition switch NAME | variant dark|light|toggle | reapply | startup [NAME]" >&2
  exit 2
}

write_atomic() {
  local path="$1" value="$2" tmp
  mkdir -p "$(dirname "$path")"
  tmp=$(mktemp "${path}.XXXXXX")
  printf '%s\n' "$value" > "$tmp"
  mv "$tmp" "$path"
}

read_state() {
  local path="$1" fallback="$2"
  cat "$path" 2>/dev/null || printf '%s\n' "$fallback"
}

write_pending_identity() {
  write_atomic "$TRANSITION_TARGET_FILE" "$1"
  write_atomic "$TRANSITION_VARIANT_FILE" "$2"
}

clear_pending_identity() {
  rm -f -- "$TRANSITION_TARGET_FILE" "$TRANSITION_VARIANT_FILE"
}

has_light_variant() {
  profile_manifest_has_variant "$1" light
}

stop_bar() {
  local bar="$1"
  case "$bar" in
    noctalia)
      if ! systemctl --user stop noctalia-shell >/dev/null 2>&1; then
        echo "Error: failed to stop noctalia-shell." >&2
        return 1
      fi
      for _ in $(seq 1 20); do
        systemctl --user is-active --quiet noctalia-shell >/dev/null 2>&1 || break
        sleep 0.1
      done
      if systemctl --user is-active --quiet noctalia-shell >/dev/null 2>&1; then
        echo "Error: noctalia-shell did not stop." >&2
        return 1
      fi
      ;;
    quickshell)
      systemctl --user stop quickshell-bar.service >/dev/null 2>&1 || true
      for _ in $(seq 1 20); do
        systemctl --user is-active --quiet quickshell-bar.service >/dev/null 2>&1 || break
        sleep 0.1
      done
      if systemctl --user is-active --quiet quickshell-bar.service >/dev/null 2>&1; then
        echo "Error: quickshell did not stop." >&2
        return 1
      fi
      ;;
  esac
}

stop_all_bars() {
  stop_bar noctalia
  stop_bar quickshell
}

start_bar() {
  local bar="$1"
  case "$bar" in
    noctalia)
      systemctl --user stop awww >/dev/null 2>&1 || true
      systemctl --user start noctalia-shell >/dev/null 2>&1
      ;;
    quickshell)
      systemctl --user start awww >/dev/null 2>&1 || true
      systemctl --user start quickshell-bar.service >/dev/null 2>&1
      ;;
  esac
}

maybe_fail_stage() {
  if [ "${PROFILE_TRANSITION_FAIL_STAGE_PATH:-}" = "$1" ]; then
    echo "Error: injected staging failure for $1" >&2
    return "${PROFILE_TRANSITION_FAILURE_STATUS:-1}"
  fi
}

verify_bar() {
  local bar="$1" attempts
  # Cold Quickshell starts (and notification-bus claim) often need >2s; keep this
  # overrideable so fixtures can stay fast.
  attempts="${PROFILE_TRANSITION_VERIFY_ATTEMPTS:-50}"
  for _ in $(seq 1 "$attempts"); do
    case "$bar" in
      noctalia)
        systemctl --user is-active --quiet noctalia-shell >/dev/null 2>&1 \
          && notification_owner_is noctalia && return 0
        ;;
      quickshell)
        systemctl --user is-active --quiet quickshell-bar.service >/dev/null 2>&1 \
          && notification_owner_is quickshell && return 0
        ;;
    esac
    sleep 0.1
  done
  echo "Error: $bar failed to become ready." >&2
  return 1
}

notification_owner_is() {
  local expected="$1"
  busctl --user status org.freedesktop.Notifications 2>/dev/null | grep -qi "$expected"
}

apply_system_preferences() {
  local cursor cursor_size gtk_theme icon_theme color_scheme failed=0 cursor_json appearance
  cursor_json=$(profile_manifest_transition_json "$TARGET" cursor)
  appearance=$(profile_manifest_transition_json "$TARGET" appearance)
  IFS=$'\t' read -r cursor cursor_size gtk_theme icon_theme < <(
    jq -nr --arg variant "$TARGET_VARIANT" --argjson cursor "$cursor_json" --argjson appearance "$appearance" '
      [$cursor.theme, $cursor.size,
       (if $variant == "light" then ($appearance.gtkThemeLight // $appearance.gtkTheme) else $appearance.gtkTheme end),
       (if $variant == "light" then ($appearance.iconThemeLight // $appearance.iconTheme) else $appearance.iconTheme end)] | @tsv'
  )
  color_scheme=prefer-dark
  [ "$TARGET_VARIANT" != light ] || color_scheme=prefer-light
  gsettings set org.gnome.desktop.interface cursor-theme "$cursor" || failed=1
  gsettings set org.gnome.desktop.interface cursor-size "$cursor_size" || failed=1
  gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" || failed=1
  gsettings set org.gnome.desktop.interface icon-theme "$icon_theme" || failed=1
  gsettings set org.gnome.desktop.interface color-scheme "$color_scheme" || failed=1
  return "$failed"
}

apply_static_wallpaper() {
  local wallpaper="" waypaper_config waypaper_folder
  [ -d "$TARGET_WALLPAPER_DIR" ] || return 0
  wallpaper=$(pick_random_wallpaper "$TARGET_WALLPAPER_DIR")
  if [ -z "$wallpaper" ]; then
    echo "Warning: no supported wallpapers found in $TARGET_WALLPAPER_DIR" >&2
    return 0
  fi
  set_wallpaper "$wallpaper"
  waypaper_config="$HOME/.config/waypaper/config.ini"
  if [ -f "$waypaper_config" ]; then
    ensure_waypaper_post_command "$waypaper_config"
    waypaper_folder="${TARGET_WALLPAPER_DIR/#$HOME/\~}"
    sed -i "s|^folder = .*|folder = $waypaper_folder|" "$waypaper_config"
    sed -i "s|^wallpaper = .*|wallpaper = ${wallpaper/#$HOME/\~}|" "$waypaper_config"
  fi
}

apply_noctalia_wallpaper() {
  local screens
  command -v noctalia >/dev/null 2>&1 || return 0
  stop_video_wallpaper
  screens=$(niri msg outputs 2>/dev/null | grep '^Output ' \
    | sed 's/^Output ".*" (\(.*\))/\1/')

  run_noctalia_wallpaper_job() {
    local first=1 screen
    while IFS= read -r screen; do
      [ -n "$screen" ] || continue
      if [ "$first" -eq 1 ]; then
        for _ in $(seq 1 40); do
          noctalia msg wallpaper-random "$screen" 2>/dev/null && break
          sleep 0.25
        done
        first=0
      else
        noctalia msg wallpaper-random "$screen" 2>/dev/null || true
      fi
    done <<< "$screens"
    noctalia msg templates-apply 2>/dev/null || true
  }

  if [ -n "${PROFILE_TRANSITION_TEST_SYNC_ASYNC:-}" ]; then
    run_theme_side_effect_if_current "$THEME_GENERATION" run_noctalia_wallpaper_job
  else
    (
      unset PROFILE_PUBLISH_LOCK_FD
      run_theme_side_effect_if_current "$THEME_GENERATION" run_noctalia_wallpaper_job
    ) 9>&- &
    disown 2>/dev/null || true
  fi
}

apply_wallpaper_adapter() {
  if [ "$TARGET_SELF_THEMED" = true ]; then
    apply_noctalia_wallpaper
  else
    apply_static_wallpaper
  fi
}

start_profile_switcher() {
  local switcher_path="$REPO_HOME/configs/quickshell-switcher/shell.qml"
  pgrep -f "quickshell.*quickshell-switcher/shell.qml" >/dev/null 2>&1 && return 0
  if [ -n "${PROFILE_TRANSITION_TEST_SYNC_ASYNC:-}" ]; then
    quickshell -p "$switcher_path" 9>&- >/dev/null 2>&1
  else
    quickshell -p "$switcher_path" 9>&- >/dev/null 2>&1 &
    disown 2>/dev/null || true
  fi
}

send_profile_notification() {
  notify-send "Desktop Profile" "Switched to $TARGET"
}

run_post_commit_adapter() {
  local name="$1" capture first detail="" state_dir status=0
  shift
  capture=$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/profile-transition-$name.XXXXXX")
  if [ "${PROFILE_TRANSITION_FAIL_ADAPTER:-}" = "$name" ]; then
    status=1
  else
    "$@" 2>"$capture" || status=$?
  fi
  if [ "$status" -ne 0 ]; then
    first=$(grep -m1 -v '^[[:space:]]*$' "$capture" || true)
    if [ "$(grep -c . "$capture" || true)" -gt 1 ]; then
      state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-profiles/adapter-errors"
      mkdir -p "$state_dir"
      detail=$(mktemp "$state_dir/$name.XXXXXX.log")
      install -m 600 "$capture" "$detail"
    fi
    printf '%s%s%s\n' "$name" "${first:+: $first}" "${detail:+ (details: $detail)}" \
      >> "$ADAPTER_FAILURE_LOG"
  fi
  rm -f "$capture"
}

apply_niri_reload() {
  niri msg action load-config-file >/dev/null 2>&1
}

# apply_visual_commit
# Fire on-screen chrome together (still under the rollback trap) so niri
# gaps/borders, wallpaper, and the Quickshell theme stamp do not land at
# different times. A freshly started bar reads pending identity files until
# commit; the stamp nudge then follows committed active/variant. Cursor/GTK
# follow immediately in post-commit via system-preferences (soft-fail with
# the usual adapter warning).
apply_visual_commit() {
  apply_niri_reload
  apply_wallpaper_adapter
  if [ "$TARGET_BAR" = quickshell ] && [ "$MODE" != startup ]; then
    nudge_quickshell_theme_reload
  fi
}

dispatch_post_commit_adapters() {
  local summary
  ADAPTER_FAILURE_LOG=$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/profile-transition-adapters.XXXXXX")
  trap 'rm -f "$ADAPTER_FAILURE_LOG"' EXIT INT TERM HUP

  run_post_commit_adapter system-preferences run_theme_side_effect_if_current \
    "$THEME_GENERATION" apply_system_preferences
  run_post_commit_adapter profile-switcher run_theme_side_effect_if_current \
    "$THEME_GENERATION" start_profile_switcher

  if [ "$MODE" != startup ]; then
    if [ "$TARGET_SELF_THEMED" = true ]; then
      run_post_commit_adapter cava run_theme_side_effect_if_current \
        "$THEME_GENERATION" restore_cava_noctalia_theme
    else
      run_post_commit_adapter tmux run_theme_side_effect_if_current \
        "$THEME_GENERATION" tmux source-file "$CONFIG_HOME/tmux/profile-colors.conf"
      run_post_commit_adapter zathura run_theme_side_effect_if_current \
        "$THEME_GENERATION" reload_zathura_theme
      run_post_commit_adapter cava run_theme_side_effect_if_current \
        "$THEME_GENERATION" pkill -USR2 -x cava
      run_post_commit_adapter vicinae run_theme_side_effect_if_current \
        "$THEME_GENERATION" systemctl --user try-reload-or-restart vicinae.service
      run_post_commit_adapter swayosd run_theme_side_effect_if_current \
        "$THEME_GENERATION" restart_swayosd
    fi
    run_post_commit_adapter kitty run_theme_side_effect_if_current \
      "$THEME_GENERATION" reload_kitty
    run_post_commit_adapter gtk run_theme_side_effect_if_current \
      "$THEME_GENERATION" nudge_gtk_reload
    # Not in the branch above: self-themed profiles have no baked firefox colors
    # but do have a live palette (noctalia colors.json) to fall back on.
    if ! profile_wallpaper_theming "$TARGET"; then
      run_post_commit_adapter spicetify run_theme_side_effect_if_current "$THEME_GENERATION" \
        apply_spicetify_theme "$TARGET_RUNTIME" "$TARGET_VARIANT"
    fi
    run_post_commit_adapter notification run_theme_side_effect_if_current \
      "$THEME_GENERATION" send_profile_notification
  fi

  if [ -s "$ADAPTER_FAILURE_LOG" ]; then
    summary=$(paste -sd, "$ADAPTER_FAILURE_LOG")
    echo "Warning: post-commit adapters failed: $summary" >&2
  fi
  rm -f "$ADAPTER_FAILURE_LOG"
  trap - EXIT INT TERM HUP
  if [ -n "${PROFILE_TRANSITION_TEST_COMPLETION_FILE:-}" ]; then
    touch "$PROFILE_TRANSITION_TEST_COMPLETION_FILE"
  fi
}

[ $# -ge 1 ] || usage
MODE="$1"
shift

case "$MODE" in
  switch)
    [ $# -eq 1 ] || usage
    REQUESTED_TARGET="$1"
    ;;
  variant)
    [ $# -eq 1 ] || usage
    case "$1" in
      dark | light | toggle) REQUESTED_VARIANT="$1" ;;
      *) usage ;;
    esac
    ;;
  reapply)
    [ $# -eq 0 ] || usage
    ;;
  startup)
    [ $# -le 1 ] || usage
    REQUESTED_TARGET="${1:-}"
    ;;
  *) usage ;;
esac

LOCK_PATH="${PROFILE_TRANSITION_LOCK:-$HOME/.local/state/desktop-profiles/transition.lock}"
mkdir -p "$(dirname "$LOCK_PATH")"
exec 9>"$LOCK_PATH"
flock -n 9 || {
  echo "Error: another profile transition is in progress: $LOCK_PATH" >&2
  exit 75
}
export PROFILE_PUBLISH_LOCK_FD=9

if [ -n "${PROFILE_TRANSITION_TEST_AFTER_LOCK_DIR:-}" ]; then
  touch "$PROFILE_TRANSITION_TEST_AFTER_LOCK_DIR/acquired"
  while [ ! -e "$PROFILE_TRANSITION_TEST_AFTER_LOCK_DIR/release" ]; do
    sleep 0.01
  done
fi

CURRENT=$(read_state "$ACTIVE_FILE" "")
CURRENT_VARIANT=$(read_state "$VARIANT_FILE" "dark")

case "$MODE" in
  switch)
    TARGET="$REQUESTED_TARGET"
    TARGET_VARIANT=$(read_state "$PROFILES_DIR/variant-$TARGET" "dark")
    WRITE_PREFERENCE=1
    ;;
  variant)
    [ -n "$CURRENT" ] || { echo "Error: no active profile." >&2; exit 1; }
    TARGET="$CURRENT"
    if ! has_light_variant "$TARGET"; then
      echo "Profile '$TARGET' has no light variant, nothing to do."
      exit 0
    fi
    case "$REQUESTED_VARIANT" in
      dark | light)
        if [ "$REQUESTED_VARIANT" = "$CURRENT_VARIANT" ]; then
          echo "$TARGET is already $CURRENT_VARIANT."
          exit 0
        fi
        TARGET_VARIANT="$REQUESTED_VARIANT"
        ;;
      toggle)
        if [ "$CURRENT_VARIANT" = dark ]; then
          TARGET_VARIANT=light
        else
          TARGET_VARIANT=dark
        fi
        ;;
    esac
    WRITE_PREFERENCE=1
    ;;
  reapply)
    [ -n "$CURRENT" ] || { echo "Error: no active profile to reapply." >&2; exit 1; }
    TARGET="$CURRENT"
    TARGET_VARIANT="$CURRENT_VARIANT"
    WRITE_PREFERENCE=1
    ;;
  startup)
    TARGET="${REQUESTED_TARGET:-${CURRENT:-noctalia}}"
    if [ -n "$REQUESTED_TARGET" ] && [ "$TARGET" != "$CURRENT" ]; then
      TARGET_VARIANT=$(read_state "$PROFILES_DIR/variant-$TARGET" "dark")
    else
      TARGET_VARIANT="$CURRENT_VARIANT"
    fi
    WRITE_PREFERENCE=0
    if [ ! -d "$PROFILES_DIR/$TARGET" ]; then
      TARGET="noctalia"
      TARGET_VARIANT="dark"
      WRITE_PREFERENCE=1
    fi
    ;;
esac

[ -d "$PROFILES_DIR/$TARGET" ] || { echo "Error: profile '$TARGET' not found." >&2; exit 1; }
profile_manifest_validate "$TARGET" "$TARGET_VARIANT"
if [ "$TARGET_VARIANT" = "light" ] && ! has_light_variant "$TARGET"; then
  echo "Error: profile '$TARGET' has no light variant." >&2
  exit 1
fi

TARGET_DIR="$PROFILES_DIR/$TARGET"
TARGET_RUNTIME="$TARGET_DIR/manifest.json"
TARGET_SELF_THEMED=$(profile_manifest_capability "$TARGET" selfThemed)
TARGET_WALLPAPER_DIR=$(profile_manifest_wallpaper_dir "$TARGET" "$TARGET_VARIANT")

OLD_ACTIVE=$(read_state "$ACTIVE_FILE" "")
OLD_VARIANT=$(read_state "$VARIANT_FILE" "dark")
CURRENT_BAR="noctalia"
if [ -n "$OLD_ACTIVE" ] && [ -f "$PROFILES_DIR/$OLD_ACTIVE/manifest.json" ]; then
  CURRENT_BAR=$(profile_bar "$OLD_ACTIVE")
fi
TARGET_BAR=$(profile_bar "$TARGET")

# Claim a monotonically increasing desired generation while serializing only the
# state read. Rendering and staging happen after this short critical section;
# publication later rechecks the generation under the same lock.
THEME_GENERATION=$("$SCRIPT_DIR/profile-publish" allocate)
flock -u 9
exec 9>&-
unset PROFILE_PUBLISH_LOCK_FD

cleanup_transaction() {
  local status="$1"
  trap - EXIT INT TERM HUP
  rm -rf "$TRANSACTION_DIR" || true
  exit "$status"
}
TRANSACTION_ROOT="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
mkdir -p "$TRANSACTION_ROOT"
TRANSACTION_DIR=$(mktemp -d "$TRANSACTION_ROOT/profile-transition.XXXXXX")
trap 'cleanup_transaction $?' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
chmod 700 "$TRANSACTION_DIR"
SNAPSHOT_COUNT=0
declare -a SNAPSHOT_KINDS=()
declare -a SNAPSHOT_PATHS=()
declare -a SNAPSHOT_PAYLOADS=()
declare -A SNAPSHOT_ENROLLED=()
declare -a STAGED_SOURCES=()
declare -a STAGED_DESTINATIONS=()

snapshot_path() {
  local path="$1" kind payload=""
  [ -z "${SNAPSHOT_ENROLLED[$path]:-}" ] || return 0
  SNAPSHOT_COUNT=$((SNAPSHOT_COUNT + 1))
  if [ -L "$path" ]; then
    kind=symlink
    [ "${PROFILE_TRANSITION_FAIL_SNAPSHOT:-}" != payload ] || return 23
    IFS= read -r -d '' payload < <(readlink -z -- "$path") || return $?
  elif [ -f "$path" ]; then
    kind=file
    payload="$TRANSACTION_DIR/$SNAPSHOT_COUNT"
    [ "${PROFILE_TRANSITION_FAIL_SNAPSHOT:-}" != payload ] || return 23
    cp -p -- "$path" "$payload" || return $?
  elif [ ! -e "$path" ]; then
    kind=missing
  else
    echo "Error: cannot snapshot unsupported path: $path" >&2
    return 1
  fi
  [ "${PROFILE_TRANSITION_FAIL_SNAPSHOT:-}" != manifest ] || return 24
  SNAPSHOT_KINDS+=("$kind")
  SNAPSHOT_PATHS+=("$path")
  SNAPSHOT_PAYLOADS+=("$payload")
  SNAPSHOT_ENROLLED["$path"]=1
  if [ -n "${PROFILE_TRANSITION_SIGNAL_DURING_SNAPSHOT:-}" ]; then
    kill -s "$PROFILE_TRANSITION_SIGNAL_DURING_SNAPSHOT" "$$"
  fi
}

snapshot_destination() {
  local path="$1" parent missing
  local -a missing_parents=()
  parent=$(dirname "$path")
  while [ ! -d "$parent" ]; do
    missing_parents+=("$parent")
    [ "$parent" != / ] || break
    parent=$(dirname "$parent")
  done
  for ((missing=${#missing_parents[@]} - 1; missing >= 0; missing--)); do
    parent="${missing_parents[$missing]}"
    [ -z "${SNAPSHOT_ENROLLED[$parent]:-}" ] || continue
    SNAPSHOT_KINDS+=(missing-directory)
    SNAPSHOT_PATHS+=("$parent")
    SNAPSHOT_PAYLOADS+=("")
    SNAPSHOT_ENROLLED["$parent"]=1
  done
  snapshot_or_abort "$path"
}

snapshot_or_abort() {
  local status
  set +e
  snapshot_path "$1"
  status=$?
  set -e
  [ "$status" -ne 0 ] || return 0
  exit "$status"
}

restore_snapshot() {
  local index kind payload path tmp restore_errors=0
  for ((index=${#SNAPSHOT_PATHS[@]} - 1; index >= 0; index--)); do
    kind="${SNAPSHOT_KINDS[$index]}"
    path="${SNAPSHOT_PATHS[$index]}"
    payload="${SNAPSHOT_PAYLOADS[$index]}"
    if [ "${PROFILE_TRANSITION_FAIL_RESTORE_PATH:-}" = "$path" ] \
      && [ "${RESTORE_FAILURE_INJECTED:-0}" -eq 0 ]; then
      RESTORE_FAILURE_INJECTED=1
      echo "rollback: restore $path failed" >&2
      restore_errors=1
      continue
    fi
    case "$kind" in
      missing)
        rm -f -- "$path" || restore_errors=1
        ;;
      missing-directory)
        rmdir -- "$path" 2>/dev/null || restore_errors=1
        ;;
      file)
        mkdir -p "$(dirname "$path")" || { restore_errors=1; continue; }
        tmp=$(mktemp "${path}.XXXXXX") || { restore_errors=1; continue; }
        if ! cp -p -- "$payload" "$tmp" || ! mv -f -- "$tmp" "$path"; then
          rm -f -- "$tmp"
          echo "rollback: restore $path failed" >&2
          restore_errors=1
        fi
        ;;
      symlink)
        if ! link_atomic "$path" "$payload"; then
          echo "rollback: restore $path failed" >&2
          restore_errors=1
        fi
        ;;
    esac
  done
  return "$restore_errors"
}

rollback() {
  local status="$1" rollback_errors=0
  trap - EXIT INT TERM HUP
  clear_pending_identity
  set +e
  rollback_try() {
    local label="$1"
    shift
    if ! "$@"; then
      echo "rollback: $label failed" >&2
      rollback_errors=1
    fi
  }
  rollback_try "target bar stop" stop_bar "$TARGET_BAR"
  rollback_try "snapshot restore" restore_snapshot
  rollback_try "Niri reload" niri msg action load-config-file
  if [ -n "$OLD_ACTIVE" ] && [ -f "$PROFILES_DIR/$OLD_ACTIVE/manifest.json" ]; then
    rollback_try "previous bar restart" start_bar "$CURRENT_BAR"
    rollback_try "previous bar verification" verify_bar "$CURRENT_BAR"
  fi
  rollback_try "snapshot cleanup" rm -rf "$TRANSACTION_DIR"
  [ "$rollback_errors" -eq 0 ] || echo "rollback: one or more recovery operations failed" >&2
  exit "$status"
}

collect_staged_files() {
  local source relative destination
  while IFS= read -r -d '' source; do
    relative=${source#"$TRANSACTION_DIR/home/"}
    destination="$HOME/$relative"
    maybe_fail_stage "$destination"
    STAGED_SOURCES+=("$source")
    STAGED_DESTINATIONS+=("$destination")
  done < <(find "$TRANSACTION_DIR/home" -type f -print0 | sort -z)
}

install_staged_files() {
  local index source destination temporary
  for ((index=0; index<${#STAGED_SOURCES[@]}; index++)); do
    source="${STAGED_SOURCES[$index]}"
    destination="${STAGED_DESTINATIONS[$index]}"
    if [ "${PROFILE_TRANSITION_FAIL_INSTALL_PATH:-}" = "$destination" ]; then
      echo "Error: injected install failure for $destination" >&2
      return "${PROFILE_TRANSITION_FAILURE_STATUS:-1}"
    fi
    mkdir -p "$(dirname "$destination")"
    temporary=$(mktemp "$(dirname "$destination")/.profile-transition.XXXXXX")
    if ! install -m 644 "$source" "$temporary" || ! mv -f "$temporary" "$destination"; then
      rm -f "$temporary"
      return 1
    fi
  done
}

commit_preferences() {
  if [ "$WRITE_PREFERENCE" -eq 1 ]; then
    write_atomic "$ACTIVE_FILE" "$TARGET"
    [ "${PROFILE_TRANSITION_FAIL_COMMIT_AFTER:-}" != active ] || return 1
    write_atomic "$VARIANT_FILE" "$TARGET_VARIANT"
    [ "${PROFILE_TRANSITION_FAIL_COMMIT_AFTER:-}" != variant ] || return 1
    write_atomic "$PROFILES_DIR/variant-$TARGET" "$TARGET_VARIANT"
    [ "${PROFILE_TRANSITION_FAIL_COMMIT_AFTER:-}" != preference ] || return 1
  fi
  clear_pending_identity
  PREFS_COMMITTED=1
}

commit_transaction() {
  if [ "${PREFS_COMMITTED:-0}" -eq 0 ]; then
    commit_preferences || return 1
  fi
  trap 'cleanup_transaction $?' EXIT
  if [ -n "${PROFILE_TRANSITION_SIGNAL_AFTER_COMMIT:-}" ]; then
    kill -s "$PROFILE_TRANSITION_SIGNAL_AFTER_COMMIT" "$$"
  fi
  rm -rf "$TRANSACTION_DIR"
  trap - EXIT INT TERM HUP
}

stage_profile_core_files "$PROFILES_DIR/$TARGET" "$TARGET_VARIANT" "$TRANSACTION_DIR"
stage_post_commit_files() {
  local relative source destination local_config_home local_data_home local_firefox_chrome
  local stage_obsidian_vault=""
  local -a mutable=(
    .config/btop/btop.conf
    .config/cava/config
    .config/zed/settings.json
    .config/vesktop/settings/settings.json
  )

  for relative in "${mutable[@]}"; do
    source="$HOME/$relative"
    destination="$TRANSACTION_DIR/home/$relative"
    if [ -f "$source" ]; then
      mkdir -p "$(dirname "$destination")"
      install -m 644 "$source" "$destination"
    fi
  done

  (
    local_config_home="$CONFIG_HOME"
    local_data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
    local_firefox_chrome="$FIREFOX_CHROME"
    CONFIG_HOME="$TRANSACTION_DIR/home/.config"
    XDG_DATA_HOME="$TRANSACTION_DIR/home/.local/share"
    XDG_STATE_HOME="$TRANSACTION_DIR/home/.local/state"
    VARIANT_FILE="$TRANSACTION_DIR/adapter-variant"
    FIREFOX_CHROME=""
    export XDG_CONFIG_HOME="$CONFIG_HOME" XDG_DATA_HOME XDG_STATE_HOME PROFILE_STAGE_ONLY=1
    write_atomic "$VARIANT_FILE" "$TARGET_VARIANT"
    if [ -n "$local_firefox_chrome" ] && [[ "$local_firefox_chrome" == "$HOME"/* ]]; then
      FIREFOX_CHROME="$TRANSACTION_DIR/home/${local_firefox_chrome#"$HOME"/}"
      mkdir -p "$FIREFOX_CHROME/DownToneUI"
      [ ! -f "$local_firefox_chrome/DownToneUI/_globals.css" ] || \
        install -m 644 "$local_firefox_chrome/DownToneUI/_globals.css" "$FIREFOX_CHROME/DownToneUI/_globals.css"
    fi
    if [ -f "$OBSIDIAN_MINIMAL_SETTINGS" ] && [[ "$OBSIDIAN_MINIMAL_SETTINGS" == "$HOME"/* ]]; then
      stage_obsidian_vault="$TRANSACTION_DIR/home/${OBSIDIAN_MINIMAL_SETTINGS#"$HOME"/}"
      stage_obsidian_vault=${stage_obsidian_vault%/.obsidian/plugins/*}
      mkdir -p "$stage_obsidian_vault/.obsidian/plugins/obsidian-minimal-settings"
      install -m 644 "$OBSIDIAN_MINIMAL_SETTINGS" \
        "$stage_obsidian_vault/.obsidian/plugins/obsidian-minimal-settings/data.json"
      [ ! -f "${OBSIDIAN_MINIMAL_SETTINGS%/plugins/*}/appearance.json" ] || \
        install -m 644 "${OBSIDIAN_MINIMAL_SETTINGS%/plugins/*}/appearance.json" "$stage_obsidian_vault/appearance.json"
      OBSIDIAN_MINIMAL_SETTINGS="$stage_obsidian_vault/.obsidian/plugins/obsidian-minimal-settings/data.json"
    fi
    if [ "$TARGET_SELF_THEMED" != true ]; then
      apply_btop_theme "$TARGET_DIR" "$TARGET_VARIANT"
      apply_tmux_colors "$TARGET_DIR" "$TARGET_VARIANT"
      apply_zathura_theme "$TARGET_DIR" "$TARGET_VARIANT"
      apply_hyprlock_colors "$TARGET_DIR" "$TARGET_VARIANT"
      apply_cava_colors "$TARGET_DIR" "$TARGET_VARIANT"
      apply_vicinae_theme "$TARGET_DIR" "$TARGET_VARIANT"
    fi
    write_firefox_globals "$TARGET_RUNTIME" "$TARGET_VARIANT"
    apply_zed_theme "$TARGET_RUNTIME" "$TARGET_VARIANT"
    apply_vesktop_theme "$TARGET_RUNTIME" "$TARGET_VARIANT"
    apply_obsidian_scheme "$TARGET_RUNTIME" "$TARGET_VARIANT"
  )
}
if [ -z "${PROFILE_TRANSITION_FAIL_SNAPSHOT:-}" ]; then
  stage_post_commit_files
fi
if [ -n "${PROFILE_TRANSITION_TEST_STAGE_BARRIER_DIR:-}" ]; then
  touch "$PROFILE_TRANSITION_TEST_STAGE_BARRIER_DIR/staged"
  while [ ! -e "$PROFILE_TRANSITION_TEST_STAGE_BARRIER_DIR/release" ]; do
    sleep 0.01
  done
fi
collect_staged_files

if [ "$WRITE_PREFERENCE" -eq 1 ]; then
  snapshot_or_abort "$ACTIVE_FILE"
  snapshot_or_abort "$VARIANT_FILE"
  snapshot_or_abort "$PROFILES_DIR/variant-$TARGET"
fi
snapshot_or_abort "$ACTIVE_LINK"
for destination in "${STAGED_DESTINATIONS[@]}"; do
  snapshot_destination "$destination"
done
if [ -n "${PROFILE_TRANSITION_TEST_FILE_PATH:-}" ]; then
  snapshot_or_abort "$PROFILE_TRANSITION_TEST_FILE_PATH"
fi
if [ -n "${PROFILE_TRANSITION_TEST_SYMLINK_PATH:-}" ]; then
  snapshot_or_abort "$PROFILE_TRANSITION_TEST_SYMLINK_PATH"
fi
trap 'rollback $?' EXIT

SAME_QUICKSHELL=0
if [ "$MODE" != reapply ] \
  && [ "$MODE" != startup ] \
  && [ "$CURRENT_BAR" = quickshell ] \
  && [ "$TARGET_BAR" = quickshell ] \
  && systemctl --user is-active --quiet quickshell-bar.service >/dev/null 2>&1; then
  SAME_QUICKSHELL=1
fi

if [ -n "${PROFILE_TRANSITION_TEST_MUTATE_SNAPSHOTS:-}" ]; then
  printf 'mutated\n' > "$PROFILE_TRANSITION_TEST_FILE_PATH"
  rm -f -- "$PROFILE_TRANSITION_TEST_SYMLINK_PATH"
  ln -s -- changed "$PROFILE_TRANSITION_TEST_SYMLINK_PATH"
  exit 29
fi

exec 9>"$LOCK_PATH"
flock 9
export PROFILE_PUBLISH_LOCK_FD=9
if [ "$("$SCRIPT_DIR/profile-publish" current "$THEME_GENERATION")" != current ]; then
  trap 'cleanup_transaction $?' EXIT
  exit 0
fi
if [ "$MODE" = reapply ]; then
  stop_all_bars
elif [ "$SAME_QUICKSHELL" -eq 0 ]; then
  stop_bar "$CURRENT_BAR"
fi
"$SCRIPT_DIR/profile-publish" declare "$TRANSACTION_DIR"
publish_result=$(PROFILE_PUBLISH_KEEP_STAGE=1 "$SCRIPT_DIR/profile-publish" \
  publish "$THEME_GENERATION" "$TRANSACTION_DIR")
if [ "$publish_result" = stale ]; then
  trap 'cleanup_transaction $?' EXIT
  exit 0
fi
[ "$publish_result" = published ] || exit 1
NIRI_OVERRIDE=$(profile_manifest_artifact "$TARGET" "$TARGET_VARIANT" niri.default)
if [ "$(read_state "$FOCUS_FILE" "off")" = "on" ] && [ "$TARGET" != "noctalia" ]; then
  NIRI_OVERRIDE=$(profile_manifest_artifact "$TARGET" "$TARGET_VARIANT" niri.focus)
fi
if profile_wallpaper_theming "$TARGET" \
  && [ -f "$PROFILES_DIR/runtime-niri-active.kdl" ] \
  && [ "$(read_state "$PROFILES_DIR/runtime-theme-profile" "")" = "$TARGET" ]; then
  NIRI_OVERRIDE="$PROFILES_DIR/runtime-niri-active.kdl"
fi
link_atomic "$ACTIVE_LINK" "$NIRI_OVERRIDE"
write_pending_identity "$TARGET" "$TARGET_VARIANT"
if [ "$SAME_QUICKSHELL" -eq 1 ]; then
  # Process may be up but not ready (e.g. lost notification bus). Never launch a
  # second Quickshell beside a live one — stop first, then restart cleanly.
  if ! verify_bar quickshell; then
    stop_bar quickshell
    start_bar quickshell
    verify_bar quickshell
  fi
else
  start_bar "$TARGET_BAR"
  verify_bar "$TARGET_BAR"
fi

# Publish active/variant before the visual burst so wallpaper adapters and
# theme selection see the target profile; still under the rollback trap.
PREFS_COMMITTED=0
commit_preferences
apply_visual_commit

commit_transaction
flock -u 9
exec 9>&-
unset PROFILE_PUBLISH_LOCK_FD
if [ -n "${PROFILE_TRANSITION_TEST_SYNC_ASYNC:-}" ]; then
  export PROFILE_TRANSITION_TEST_POST_COMMIT=1
fi
dispatch_post_commit_adapters
exit 0
