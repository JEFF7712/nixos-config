#!/usr/bin/env bash
# Apply sink volume immediately via PipeWire, then ask SwayOSD to display
# the new level without changing it again. SwayOSD's GTK thread can stall
# for seconds after idle; wpctl must not wait on that.
set -euo pipefail

case "${1:-}" in
  up)
    wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
    ;;
  down)
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
    ;;
  mute)
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    ;;
  *)
    echo "Usage: volume-adjust <up|down|mute>" >&2
    exit 1
    ;;
esac

swayosd-client --output-volume +0 >/dev/null 2>&1 || true
