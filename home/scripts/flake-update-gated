#!/usr/bin/env bash
# Gated `nix flake update` for manual runs.
#
# Snapshot flake.lock, update, eval, and revert on failure. A bare
# `nix flake update` leaves a broken lock in the working tree (seen when
# opencode-nix added sub2api requiring Go 1.27 while the pinned system nixpkgs
# only had Go 1.26); this script restores the pre-update lock instead, so
# `just switch` keeps working.
#
# Usage: flake-update-gated [--repo DIR] [--] [inputs...]
#   no inputs: update flake.lock, then eval laptop, iso, vm, and default devShell.
#   inputs: update only the named inputs, then eval laptop and iso.
#
# Env: UPDATE_LOCK (default ${TMPDIR:-/tmp}/nixos-switch.lock)
set -euo pipefail

repo="."
inputs=()
while (($#)); do
  case "$1" in
    --repo)
      repo="$2"
      shift 2
      ;;
    --)
      shift
      while (($#)); do
        inputs+=("$1")
        shift
      done
      ;;
    -*)
      echo "usage: flake-update-gated [--repo DIR] [--] [inputs...]" >&2
      exit 2
      ;;
    *)
      inputs+=("$1")
      shift
      ;;
  esac
done

partial=0
if ((${#inputs[@]} > 0)); then
  partial=1
fi

update_lock="${UPDATE_LOCK:-${TMPDIR:-/tmp}/nixos-switch.lock}"
exec {lock_fd}>>"$update_lock"
if ! flock -n "$lock_fd"; then
  echo "another switch or flake update holds $update_lock; wait for it to finish." >&2
  exit 1
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

main_lock="$repo/flake.lock"
cp -p -- "$main_lock" "$tmpdir/flake.lock.snapshot"

restore() {
  cp -f -- "$tmpdir/flake.lock.snapshot" "$main_lock"
}

if ! nix flake update --flake "$repo" "${inputs[@]}"; then
  restore
  echo "flake-update-gated: update failed; flake.lock reverted" >&2
  exit 1
fi

if cmp -s -- "$main_lock" "$tmpdir/flake.lock.snapshot"; then
  echo "flake-update-gated: flake.lock unchanged; skipping eval"
  exit 0
fi

if ! nix eval --no-write-lock-file "$repo#nixosConfigurations.laptop.config.system.build.toplevel.drvPath" >/dev/null; then
  restore
  echo "flake-update-gated: laptop eval failed; flake.lock reverted" >&2
  exit 1
fi
if ! nix eval --no-write-lock-file "$repo#nixosConfigurations.iso.config.system.build.toplevel.drvPath" >/dev/null; then
  restore
  echo "flake-update-gated: iso eval failed; flake.lock reverted" >&2
  exit 1
fi
if [ "$partial" -eq 0 ]; then
  if ! nix eval --no-write-lock-file "$repo#nixosConfigurations.vm.config.system.build.toplevel.drvPath" >/dev/null; then
    restore
    echo "flake-update-gated: vm eval failed; flake.lock reverted" >&2
    exit 1
  fi
  if ! nix eval --no-write-lock-file "$repo#devShells.x86_64-linux.default.drvPath" >/dev/null; then
    restore
    echo "flake-update-gated: devShells eval failed; flake.lock reverted" >&2
    exit 1
  fi
fi

echo "flake-update-gated: updated lock passes eval"
