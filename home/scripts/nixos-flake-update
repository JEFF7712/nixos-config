#!/usr/bin/env bash
set -euo pipefail

label=""
repo=""
target=""
commit_message=""
eval_failure="hard"
inputs=()
update_lock="${UPDATE_LOCK:-/run/nixos-auto-update.lock}"
dns_retries="${DNS_RETRIES:-60}"
dns_retry_delay="${DNS_RETRY_DELAY:-5}"
cascade_guard="${CASCADE_GUARD:-}"
nixos_rebuild="${NIXOS_REBUILD:-nixos-rebuild}"
defer_alert_after="${DEFER_ALERT_AFTER:-6}"

while (($#)); do
  case "$1" in
    --label) label=$2; shift 2 ;;
    --repo) repo=$2; shift 2 ;;
    --target) target=$2; shift 2 ;;
    --commit-message) commit_message=$2; shift 2 ;;
    --eval-failure) eval_failure=$2; shift 2 ;;
    --input) inputs+=("$2"); shift 2 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
done

case "$eval_failure" in
  hard|defer) ;;
  *)
    printf 'invalid --eval-failure: %s (expected hard or defer)\n' "$eval_failure" >&2
    exit 2
    ;;
esac

for value in label repo target commit_message; do
  [ -n "${!value}" ] || {
    printf 'missing --%s\n' "${value//_/-}" >&2
    exit 2
  }
done

safe_label="${label// /-}"
if [[ ! $safe_label =~ ^[A-Za-z0-9._-]+$ ]]; then
  printf 'invalid --label for state path: %s\n' "$label" >&2
  exit 2
fi

cascade_guard="${cascade_guard:-$repo/home/scripts/nix-cascade-guard}"
target_name="${target##*#}"
state_directory="${STATE_DIRECTORY:-}"
ephemeral_state=false
if [[ -z $state_directory ]]; then
  state_directory="$(mktemp -d "${TMPDIR:-/tmp}/nixos-flake-update.XXXXXX")"
  ephemeral_state=true
fi
pending_dir="$state_directory/pending-$safe_label"
retired_dir="$state_directory/retired-$safe_label"
deployed_file="$state_directory/deployed-$safe_label.lock"
defer_file="$state_directory/defer-count-$safe_label"
candidate_work=""

cleanup_candidate_work() {
  if [[ -n $candidate_work && -d $candidate_work ]]; then
    rm -rf -- "$candidate_work"
    candidate_work=""
  fi
}

disarm_cleanup() {
  cleanup_candidate_work
  if [[ $ephemeral_state == true ]]; then
    rm -rf -- "$state_directory"
  fi
  trap - EXIT INT TERM
}

cleanup() {
  local status=$?
  trap - EXIT INT TERM
  cleanup_candidate_work
  if [[ $ephemeral_state == true ]]; then
    rm -rf -- "$state_directory"
  fi
  exit "$status"
}

# Root auto-update must not build uncommitted edits. import-tree loads untracked
# .nix files, so those count too. Apply local edits with `just switch`.
refuse_if_dirty_tree() {
  local porcelain line path
  porcelain="$(runuser -u rupan -- git -C "$repo" status --porcelain --untracked-files=all)" || {
    printf '%s update refused: git status failed\n' "$label" >&2
    exit 1
  }
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    path="${line#?? }"
    if [[ $path == *' -> '* ]]; then
      path="${path##* -> }"
    fi
    if [[ $path == \"*\" ]]; then
      path="${path:1:${#path}-2}"
    fi
    if [[ $path != flake.lock ]]; then
      printf '%s update refused: working tree differs from HEAD besides flake.lock (%s). Apply local edits with just switch.\n' \
        "$label" "$path" >&2
      exit 1
    fi
  done <<<"$porcelain"
}

clear_defer_count() {
  rm -f -- "$defer_file"
}

atomic_write_text() {
  local directory="$1" path="$2" value="$3" temporary
  temporary="$(mktemp "$directory/.${path##*/}.XXXXXX")"
  printf '%s\n' "$value" > "$temporary"
  sync -f "$temporary"
  mv -f -- "$temporary" "$path"
  sync -f "$directory"
}

atomic_copy_file() {
  local source="$1" destination="$2" directory temporary
  directory="${destination%/*}"
  temporary="$(mktemp "$directory/.${destination##*/}.update.XXXXXX")"
  if ! cp -- "$source" "$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  chmod --reference="$destination" "$temporary"
  chown --reference="$destination" "$temporary"
  sync -f "$temporary"
  mv -f -- "$temporary" "$destination"
  sync -f "$directory"
}

consecutive_defer_exceeded() {
  local count=0
  mkdir -p "$state_directory"
  if [[ -r $defer_file ]]; then
    count=$(cat -- "$defer_file")
  fi
  if [[ $count =~ ^[0-9]+$ ]]; then
    count=$((count + 1))
  else
    count=1
  fi
  atomic_write_text "$state_directory" "$defer_file" "$count"
  if (( count >= defer_alert_after )); then
    printf '%s update: %s consecutive defers (threshold %s); surfacing stuck upstream\n' \
      "$label" "$count" "$defer_alert_after" >&2
    return 0
  fi
  return 1
}

record_deployment() {
  local deployed_tmp
  deployed_tmp="$(mktemp "$state_directory/.deployed-$safe_label.XXXXXX")"
  cp -- "$pending_dir/candidate/flake.lock" "$deployed_tmp"
  sync -f "$deployed_tmp"
  mv -f -- "$deployed_tmp" "$deployed_file"
  sync -f "$state_directory"
}

cleanup_retired_candidates() {
  local retired
  for retired in "$state_directory"/retired-*; do
    [[ -d $retired && ! -L $retired ]] || continue
    chmod -R u+w -- "$retired"
    rm -rf -- "$retired"
  done
}

cleanup_orphan_candidate_work() {
  local orphan
  for orphan in "$state_directory"/.candidate-*; do
    [[ -d $orphan && ! -L $orphan ]] || continue
    chmod -R u+w -- "$orphan"
    rm -rf -- "$orphan"
  done
}

cleanup_lock_temps() {
  local temporary
  for temporary in "$repo"/.flake.lock.update.*; do
    [[ -f $temporary && ! -L $temporary ]] || continue
    rm -f -- "$temporary"
  done
}

retire_pending_candidate() {
  if [[ -e $retired_dir ]]; then
    printf '%s update: retired candidate is still present; refusing to replace it\n' "$label" >&2
    return 1
  fi
  mv -- "$pending_dir" "$retired_dir"
  chmod -R u+w -- "$retired_dir/candidate"
  rm -rf -- "$retired_dir"
}

finish_deployment() {
  record_deployment
  atomic_write_text "$pending_dir" "$pending_dir/state" deployed
  retire_pending_candidate
}

candidate_source_is_current() {
  local source_head current_head
  [[ -r $pending_dir/source-head && -r $pending_dir/source.lock ]] || return 1
  source_head="$(cat -- "$pending_dir/source-head")"
  current_head="$(runuser -u rupan -- git -C "$repo" rev-parse HEAD)" || return 1
  [[ $source_head == "$current_head" ]] && cmp -s "$pending_dir/source.lock" "$repo/flake.lock"
}

source_head_is_current() {
  local source_head current_head
  [[ -r $pending_dir/source-head ]] || return 1
  source_head="$(cat -- "$pending_dir/source-head")"
  current_head="$(runuser -u rupan -- git -C "$repo" rev-parse HEAD)" || return 1
  [[ $source_head == "$current_head" ]]
}

repo_lock_matches_head() {
  runuser -u rupan -- git -C "$repo" diff --quiet HEAD -- flake.lock
}

supersede_pending_candidate() {
  printf '%s update: pending candidate no longer matches the editable flake; retiring it\n' "$label" >&2
  retire_pending_candidate
}

candidate_lock_is_committed() {
  cmp -s "$pending_dir/candidate/flake.lock" \
    <(runuser -u rupan -- git -C "$repo" show HEAD:flake.lock)
}

pending_candidate_is_safe_to_activate() {
  local source_head current_head
  candidate_source_is_current && return 0
  candidate_lock_is_committed && repo_lock_matches_head || return 1
  source_head="$(cat -- "$pending_dir/source-head")"
  current_head="$(runuser -u rupan -- git -C "$repo" rev-parse HEAD)" || return 1
  runuser -u rupan -- git -C "$repo" merge-base --is-ancestor "$source_head" "$current_head" \
    && runuser -u rupan -- git -C "$repo" diff --quiet "$source_head" "$current_head" \
      -- . ':(exclude)flake.lock'
}

repo_lock_matches_source() {
  cmp -s "$pending_dir/source.lock" "$repo/flake.lock"
}

repo_lock_matches_candidate() {
  cmp -s "$pending_dir/candidate/flake.lock" "$repo/flake.lock"
}

restore_source_lock() {
  atomic_copy_file "$pending_dir/source.lock" "$repo/flake.lock"
}

finish_if_candidate_is_published() {
  if candidate_lock_is_committed && repo_lock_matches_head; then
    finish_deployment
    return 0
  fi
  return 1
}

resume_publication() {
  local commit_status=0
  if finish_if_candidate_is_published; then
    return 0
  fi

  if ! source_head_is_current; then
    supersede_pending_candidate
    return 0
  fi

  if repo_lock_matches_source; then
    if ! atomic_copy_file "$pending_dir/candidate/flake.lock" "$repo/flake.lock"; then
      printf '%s update: could not publish activated flake.lock\n' "$label" >&2
      return 1
    fi
  elif ! repo_lock_matches_candidate; then
    supersede_pending_candidate
    return 0
  fi

  runuser -u rupan -- git -C "$repo" commit -m "$commit_message" -- flake.lock || commit_status=$?
  if [[ $commit_status -eq 0 ]]; then
    finish_deployment
    return 0
  fi

  if finish_if_candidate_is_published; then
    return 0
  fi
  if repo_lock_matches_candidate; then
    restore_source_lock
    atomic_write_text "$pending_dir" "$pending_dir/state" activated
  else
    supersede_pending_candidate
  fi
  printf '%s update: activated candidate could not be committed; will retry next run\n' "$label" >&2
  return 1
}

commit_candidate_lock() {
  if finish_if_candidate_is_published; then
    return 0
  fi
  if ! candidate_source_is_current; then
    supersede_pending_candidate
    return 0
  fi
  atomic_write_text "$pending_dir" "$pending_dir/state" publishing
  resume_publication
}

activate_pending_candidate() {
  local candidate_ref candidate_state rebuild_status
  if [[ ! -r $pending_dir/state || ! -r $pending_dir/candidate/flake.nix \
    || ! -r $pending_dir/candidate/flake.lock || ! -r $pending_dir/source-head \
    || ! -r $pending_dir/source.lock ]]; then
    printf '%s update: pending candidate state is incomplete\n' "$label" >&2
    return 1
  fi

  candidate_state="$(cat -- "$pending_dir/state")"
  case "$candidate_state" in
    pending|activated) refuse_if_dirty_tree ;;
  esac
  case "$candidate_state" in
    pending)
      if ! pending_candidate_is_safe_to_activate; then
        supersede_pending_candidate
        return 0
      fi
      candidate_ref="path:$pending_dir/candidate#$target_name"
      rebuild_status=0
      "$nixos_rebuild" switch --flake "$candidate_ref" \
        --option max-jobs 2 --option cores 8 || rebuild_status=$?
      if [[ $rebuild_status -ne 0 ]]; then
        printf '%s update activation failed; pending candidate retained\n' "$label" >&2
        return "$rebuild_status"
      fi
      atomic_write_text "$pending_dir" "$pending_dir/state" activated
      commit_candidate_lock
      ;;
    activated)
      commit_candidate_lock
      ;;
    publishing)
      resume_publication
      ;;
    deployed)
      if ! finish_if_candidate_is_published; then
        supersede_pending_candidate
      fi
      ;;
    *)
      printf '%s update: invalid pending candidate state: %s\n' "$label" "$candidate_state" >&2
      return 1
      ;;
  esac
}

exec {lock_fd}>"$update_lock"
flock -n "$lock_fd" || exit 0

mkdir -p "$state_directory"
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

cleanup_retired_candidates
cleanup_orphan_candidate_work
cleanup_lock_temps

if [[ -e $pending_dir ]]; then
  activate_pending_candidate
  disarm_cleanup
  exit 0
fi

refuse_if_dirty_tree

dns_ready=false
for ((attempt = 0; attempt < dns_retries; attempt++)); do
  if getent hosts api.github.com >/dev/null 2>&1; then
    dns_ready=true
    break
  fi
  if ((attempt + 1 < dns_retries)); then
    sleep "$dns_retry_delay"
  fi
done
if [[ $dns_ready != true ]]; then
  printf '%s update: DNS unavailable\n' "$label" >&2
  exit 1
fi

candidate_work="$(mktemp -d "$state_directory/.candidate-$safe_label.XXXXXX")"
chmod 0755 "$candidate_work"
mkdir "$candidate_work/candidate"
source_head="$(runuser -u rupan -- git -C "$repo" rev-parse HEAD)" || {
  printf '%s update: could not record source HEAD\n' "$label" >&2
  exit 1
}
if ! runuser -u rupan -- git -C "$repo" archive --format=tar HEAD \
  | tar -x -C "$candidate_work/candidate"; then
  printf '%s update: could not create candidate snapshot\n' "$label" >&2
  exit 1
fi
chown -R rupan:users "$candidate_work/candidate"
chmod -R u+w "$candidate_work/candidate"
cp --preserve=mode,timestamps -- "$repo/flake.lock" "$candidate_work/source.lock"
cp --preserve=mode,timestamps -- "$repo/flake.lock" "$candidate_work/candidate/flake.lock"
atomic_write_text "$candidate_work" "$candidate_work/source-head" "$source_head"

candidate_ref="path:$candidate_work/candidate#$target_name"
toplevel="${candidate_ref%%#*}#nixosConfigurations.${target_name}.config.system.build.toplevel"

if ! runuser -u rupan -- nix flake update --flake "path:$candidate_work/candidate" "${inputs[@]}"; then
  printf '%s update failed; flake.lock reverted\n' "$label" >&2
  exit 1
fi

if ! runuser -u rupan -- nix eval --no-write-lock-file \
  "${toplevel}.drvPath" >/dev/null; then
  if [[ $eval_failure == defer ]]; then
    printf '%s update deferred: updated inputs fail eval; flake.lock reverted, will retry next run\n' \
      "$label" >&2
    if consecutive_defer_exceeded; then
      exit 1
    fi
    disarm_cleanup
    exit 0
  fi
  printf '%s update fails eval; flake.lock reverted\n' "$label" >&2
  exit 1
fi

compare_status=0
cmp -s -- "$candidate_work/candidate/flake.lock" "$candidate_work/source.lock" || compare_status=$?
case "$compare_status" in
  0)
    clear_defer_count
    printf '%s flake.lock unchanged; skipping rebuild\n' "$label"
    disarm_cleanup
    exit 0
    ;;
  1) ;;
  *)
    printf '%s could not compare flake.lock snapshot (rc=%d); lock reverted\n' \
      "$label" "$compare_status" >&2
    exit 1
    ;;
esac

cascade_status=0
runuser -u rupan -w PATH -- "$cascade_guard" \
  "$toplevel" || cascade_status=$?
if [[ $cascade_status -eq 10 ]]; then
  printf '%s update deferred: toolchain cascade; flake.lock reverted\n' "$label" >&2
  if consecutive_defer_exceeded; then
    exit 1
  fi
  disarm_cleanup
  exit 0
elif [[ $cascade_status -ne 0 ]]; then
  printf '%s cascade guard failed (rc=%d); flake.lock reverted\n' \
    "$label" "$cascade_status" >&2
  exit 1
fi

sync -f "$candidate_work/candidate/flake.lock" "$candidate_work/candidate" \
  "$candidate_work/source.lock" "$candidate_work/source-head" \
  "$candidate_work"
atomic_write_text "$candidate_work" "$candidate_work/state" pending
chmod -R a-w "$candidate_work/candidate"
if ((EUID == 0)); then
  chown -R root:root "$candidate_work/candidate"
fi
sync -f "$candidate_work/candidate" "$candidate_work"
mv -- "$candidate_work" "$pending_dir"
sync -f "$state_directory"
candidate_work=""
clear_defer_count
activate_pending_candidate
disarm_cleanup
