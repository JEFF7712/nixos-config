#!/usr/bin/env bash
# Regenerate the Firefox DownToneUI _globals.css from the active profile's colors.
# Standalone entry point for consumers that change the palette without going
# through profile-transition (noctalia's template post_hook).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
. "$SCRIPT_DIR/profile-common"

profile=$(cat "$ACTIVE_FILE" 2>/dev/null || true)
[ -n "$profile" ] || exit 0
variant=$(cat "$VARIANT_FILE" 2>/dev/null || echo dark)
write_firefox_globals "$PROFILES_DIR/$profile/manifest.json" "$variant"
