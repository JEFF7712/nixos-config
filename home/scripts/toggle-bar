#!/usr/bin/env bash
set -euo pipefail

unit=quickshell-bar.service
if [ "$(jq -r '.transition.defaultBar // "quickshell"' "$HOME/.config/desktop-profiles/$(cat "$HOME/.config/desktop-profiles/active" 2>/dev/null)/manifest.json" 2>/dev/null)" = folio ]; then
  unit=folio-shell.service
fi

if systemctl --user is-active --quiet "$unit"; then
  systemctl --user stop "$unit"
else
  systemctl --user start "$unit"
fi
