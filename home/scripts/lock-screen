#!/usr/bin/env bash
# Render a profile-themed hyprlock config and lock the session.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
. "$SCRIPT_DIR/profile-manifest"

DEFAULT_LOCK_FONT="JetBrainsMono Nerd Font"

hyprlock_font_var() {
  local file="$1" name="$2"
  [ -r "$file" ] || return 0
  awk -F ' = ' -v name="$name" '$1 == name { print $2; exit }' "$file"
}

resolve_lock_fonts() {
  local profile="$1"
  local font_file="$2"
  local ui_font mono_font loaded
  ui_font=$(profile_manifest_font_family "$profile" ui "$DEFAULT_LOCK_FONT")
  mono_font=$(profile_manifest_font_family "$profile" mono "$DEFAULT_LOCK_FONT")
  loaded=$(hyprlock_font_var "$font_file" '$font')
  [ -n "$loaded" ] && ui_font="$loaded"
  loaded=$(hyprlock_font_var "$font_file" '$mono_font')
  [ -n "$loaded" ] && mono_font="$loaded"
  printf '%s\t%s\n' "$ui_font" "$mono_font"
}

ACTIVE_FILE="$PROFILES_DIR/active"
PROFILE=""
[ -f "$ACTIVE_FILE" ] && PROFILE=$(cat "$ACTIVE_FILE")

# Idle timer, lid-close-action, and Stasis prepare_sleep_command all fire
# this script, often for the same suspend. A second hyprlock can never own
# the session lock (niri logs "refusing lock as already locked"), and the
# loser lingers: later it grabs a dead lock ("replacing existing dead
# lock") or stalls post-resume with no input accepted, forcing a hard
# power-off. One instance only.
if pgrep -x hyprlock >/dev/null 2>&1; then
  exit 0
fi
PROFILE_DIR="$PROFILES_DIR/$PROFILE"
VARIANT=$(cat "$PROFILES_DIR/active-variant" 2>/dev/null || echo "dark")
  THEME_FILE="$PROFILE_DIR/quickshell-theme.json"
  if [ "$VARIANT" = "light" ] && [ -r "$PROFILE_DIR/quickshell-theme-light.json" ]; then
    THEME_FILE="$PROFILE_DIR/quickshell-theme-light.json"
  fi
  if [ -s "$PROFILES_DIR/runtime-quickshell-theme.json" ] \
    && [ "$(cat "$PROFILES_DIR/runtime-theme-profile" 2>/dev/null || true)" = "$PROFILE" ] \
    && [ "$(cat "$PROFILES_DIR/runtime-theme-variant" 2>/dev/null || true)" = "$VARIANT" ]; then
    THEME_FILE="$PROFILES_DIR/runtime-quickshell-theme.json"
  fi
  WAYPAPER_CFG="$HOME/.config/waypaper/config.ini"
  FONT_FILE="$HOME/.config/hypr/profile-font.conf"
  COLORS_FILE="$HOME/.config/hypr/profile-colors.conf"
  MOTION_FILE="$HOME/.config/hypr/profile-motion.conf"
  CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/hyprlock"
  RUNTIME_CONFIG="$CACHE_DIR/profile.conf"

  normalize_hex() {
    local color="${1#\#}"
    case "${#color}" in
      6) printf '%s\n' "$color" ;;
      8) printf '%s\n' "${color:2:6}" ;;
      *) printf '%s\n' "$2" ;;
    esac
  }

  normalize_alpha() {
    local color="${1#\#}"
    case "${#color}" in
      8) printf '%s\n' "${color:0:2}" ;;
      *) printf '%s\n' "$2" ;;
    esac
  }

  rgb_color() {
    printf 'rgb(%s)' "$(normalize_hex "$1" "$2")"
  }

  rgba_color() {
    local rgb alpha
    rgb=$(normalize_hex "$1" "$2")
    alpha=$(normalize_alpha "$1" "$3")
    printf 'rgba(%s%s)' "$rgb" "$alpha"
  }

  theme_value() {
    local key="$1" fallback="$2"
    if [ -r "$THEME_FILE" ]; then
      jq -r --arg key "$key" --arg fallback "$fallback" '.[$key] // $fallback' "$THEME_FILE" 2>/dev/null
    else
      printf '%s\n' "$fallback"
    fi
  }

  current_wallpaper() {
    local wallpaper=""
    if [ -r "$WAYPAPER_CFG" ]; then
      wallpaper=$(awk -F' = ' '$1 == "wallpaper" { print $2; exit }' "$WAYPAPER_CFG")
      wallpaper="${wallpaper/#\~/$HOME}"
    fi

    if [ -n "$wallpaper" ] && [ -f "$wallpaper" ]; then
      case "${wallpaper,,}" in
        *.mp4 | *.webm | *.mkv | *.mov)
          mkdir -p "$CACHE_DIR"
          local frame="$CACHE_DIR/video-backdrop.png"
          if command -v ffmpeg >/dev/null 2>&1 \
            && ffmpeg -y -loglevel error -i "$wallpaper" -frames:v 1 "$frame" >/dev/null 2>&1 \
            && [ -s "$frame" ]; then
            printf '%s\n' "$frame"
            return 0
          fi
          ;;
        *)
          printf '%s\n' "$wallpaper"
          return 0
          ;;
      esac
    fi

    local variant wallpaper_dir profile
    variant=$(cat "$PROFILES_DIR/active-variant" 2>/dev/null || echo "dark")
    profile=$(basename "$PROFILE_DIR")
    wallpaper_dir=$(profile_manifest_wallpaper_dir "$profile" "$variant")

    if [ -d "$wallpaper_dir" ]; then
      find "$wallpaper_dir" -maxdepth 1 \
        -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) \
        | sort | head -n 1
      return 0
    fi

    printf 'screenshot\n'
  }

  fg=$(theme_value fg "#eceff4")
  muted=$(theme_value second "#aeb7c5")
  accent=$(theme_value accent "#88c0d0")
  surface=$(theme_value rawBg "#171b22")
  if [ "$(normalize_hex "$fg" "eceff4")" = "$(normalize_hex "$surface" "171b22")" ]; then
    surface=$(theme_value bg "#171b22")
  fi
  panel=$(theme_value popupBg "#cc171b22")
  error=$(theme_value warm "#bf616a")

  fg_expr=$(rgb_color "$fg" "eceff4")
  muted_expr=$(rgb_color "$muted" "aeb7c5")
  accent_expr=$(rgb_color "$accent" "88c0d0")
  surface_expr=$(rgba_color "$surface" "171b22" "d9")
  surface_alt_expr=$(rgba_color "$panel" "171b22" "cc")
  border_expr=$(rgba_color "$accent" "88c0d0" "e6")
  error_expr=$(rgba_color "$error" "bf616a" "e6")
  backdrop_rgb=$(rgb_color "$surface" "171b22")
  scrim_rgba=$(rgba_color "$surface" "171b22" "40")

  if [ -s "$COLORS_FILE" ]; then
    loaded=$(hyprlock_font_var "$COLORS_FILE" '$fg')
    [ -n "$loaded" ] && fg_expr="$loaded"
    loaded=$(hyprlock_font_var "$COLORS_FILE" '$muted')
    [ -n "$loaded" ] && muted_expr="$loaded"
    loaded=$(hyprlock_font_var "$COLORS_FILE" '$accent')
    [ -n "$loaded" ] && accent_expr="$loaded"
    loaded=$(hyprlock_font_var "$COLORS_FILE" '$surface')
    if [ -n "$loaded" ]; then
      surface_expr="$loaded"
      hex_only=$(printf '%s' "$loaded" | sed -nE 's/^rgba?\(([0-9A-Fa-f]{6}).*\)$/\1/p')
      if [ -n "$hex_only" ]; then
        backdrop_rgb="rgb($hex_only)"
        scrim_rgba="rgba(${hex_only}40)"
      fi
    fi
    loaded=$(hyprlock_font_var "$COLORS_FILE" '$surface_alt')
    [ -n "$loaded" ] && surface_alt_expr="$loaded"
    loaded=$(hyprlock_font_var "$COLORS_FILE" '$border')
    [ -n "$loaded" ] && border_expr="$loaded"
    loaded=$(hyprlock_font_var "$COLORS_FILE" '$error')
    [ -n "$loaded" ] && error_expr="$loaded"
  fi

  fade_speed=$(hyprlock_font_var "$MOTION_FILE" '$hyprlock_fade_speed')
  dots_speed=$(hyprlock_font_var "$MOTION_FILE" '$hyprlock_dots_speed')
  fade_speed="${fade_speed:-4}"
  dots_speed="${dots_speed:-2}"

  flat_mode=$(theme_value flatMode "false")
  bar_radius=$(theme_value barRadius "10")
  input_rounding=10
  if [ "$flat_mode" = "true" ] || [ "$bar_radius" = "0" ]; then
    input_rounding=0
  fi

  wallpaper=$(current_wallpaper)
  IFS=$'\t' read -r ui_font mono_font < <(resolve_lock_fonts "$PROFILE" "$FONT_FILE")
  ui_font="${ui_font:-$DEFAULT_LOCK_FONT}"
  mono_font="${mono_font:-$DEFAULT_LOCK_FONT}"

  mkdir -p "$CACHE_DIR"
  cat > "$RUNTIME_CONFIG" <<EOF
\$font = $ui_font
\$mono_font = $mono_font
\$fg = $fg_expr
\$muted = $muted_expr
\$accent = $accent_expr
\$surface = $surface_expr
\$surface_alt = $surface_alt_expr
\$border = $border_expr
\$error = $error_expr

general {
    hide_cursor = true
    ignore_empty_input = false
    immediate_render = false
}

animations {
    enabled = true
    bezier = smooth, 0.22, 1, 0.36, 1
    animation = fadeIn, 1, $fade_speed, smooth
    animation = fadeOut, 1, $fade_speed, smooth
    animation = inputFieldDots, 1, $dots_speed, smooth
}

background {
    monitor =
    path = $wallpaper
    # Deterministic backdrop if the image texture fails (e.g. post-resume).
    color = $backdrop_rgb
    blur_passes = 2
    blur_size = 5
    noise = 0.008
    contrast = 0.96
    brightness = 0.68
    vibrancy = 0.22
    vibrancy_darkness = 0.12
}

shape {
    monitor =
    size = 100%, 100%
    color = $scrim_rgba
    rounding = 0
    position = 0, 0
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:1000] date +"%-I:%M"
    color = \$fg
    font_size = 92
    font_family = \$font
    position = 0, 172
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] date +"%A, %B %-d"
    color = \$muted
    font_size = 22
    font_family = \$font
    position = 0, 96
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 360, 54
    outline_thickness = 0
    rounding = $input_rounding

    outer_color = rgba(00000000)
    inner_color = rgba(00000000)
    font_color = \$fg
    check_color = \$fg
    fail_color = \$error

    font_family = \$mono_font
    placeholder_text = <span></span>
    fail_text = \$PAMFAIL
    check_text = Checking...
    capslock_color = $(rgba_color "$(theme_value warm "#ebcb8b")" "ebcb8b" "e6")
    swap_font_color = true
    fade_on_empty = false
    dots_size = 0.24
    dots_spacing = 0.22
    shadow_passes = 0
    shadow_size = 0

    position = 0, -104
    halign = center
    valign = center
}

EOF

exec hyprlock --config "$RUNTIME_CONFIG" --grace 0
