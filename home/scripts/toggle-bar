#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

. "$SCRIPT_DIR/profile-common"

ACTIVE=$(cat "$ACTIVE_FILE" 2>/dev/null || echo "")
[ -n "$ACTIVE" ] || exit 0

BAR=$(profile_bar "$ACTIVE")
toggle_quickshell() {
  if systemctl --user is-active --quiet quickshell-bar.service; then
    systemctl --user stop quickshell-bar.service
  else
    systemctl --user start quickshell-bar.service
  fi
}

case "$BAR" in
  noctalia)
    noctalia msg bar-toggle
    ;;
  quickshell)
    toggle_quickshell
    ;;
esac
