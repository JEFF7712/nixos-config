#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
WAYPAPER_CFG="$CONFIG_HOME/waypaper/config.ini"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

. "$SCRIPT_DIR/profile-common"

backend=$(awk -F' = ' '$1 == "backend" { print $2; exit }' "$WAYPAPER_CFG" 2>/dev/null || true)

case "$backend" in
  awww)
    stop_video_wallpaper
    systemctl --user start awww 2>/dev/null || true
    ;;
  mpvpaper)
    systemctl --user stop awww 2>/dev/null || true
    ;;
esac

# Read the path from waypaper's config instead of $1: waypaper runs post_command
# with shell=True and only escapes spaces, so quotes/$ in a filename break argv.
wallpaper=""
if [ -f "$WAYPAPER_CFG" ]; then
  wallpaper=$(awk -F' = ' '$1 == "wallpaper" { print $2; exit }' "$WAYPAPER_CFG" 2>/dev/null || true)
  # The tilde must be quoted: bash tilde-expands `case` PATTERNS, so a bare
  # ~/* becomes /home/<user>/* and never matches the literal ~ waypaper writes.
  case "$wallpaper" in
    "~/"*) wallpaper="$HOME/${wallpaper#"~/"}" ;;
  esac
fi
if [ -z "$wallpaper" ]; then
  wallpaper="${1:-}"
fi

apply_wallpaper_theme "$wallpaper"
