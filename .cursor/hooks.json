{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "hooks/session-start",
        "timeout": 15
      }
    ],
    "preToolUse": [
      {
        "command": "hooks/before-shell",
        "matcher": "Shell",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "hooks/after-edit",
        "timeout": 30
      }
    ],
    "postToolUseFailure": [
      {
        "command": "hooks/friction-log",
        "matcher": "Shell",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "hooks/friction-stop",
        "timeout": 10,
        "loop_limit": 1
      }
    ]
  }
}
