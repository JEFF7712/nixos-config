#!/usr/bin/env python3
"""Rewrite kitty transparent_background_colors from the active colors.conf.

Cursor Agent and Codex mix prompt/message chrome from the terminal background.
Claude Code uses hardcoded theme fills. OpenCode's "system" theme derives
panel/element fills from the terminal palette; its bundled theme clears cells
with fixed steps. Kitty only tints cells whose background matches exactly
(max 7 colors). Recompute Agent/Codex/OpenCode mixes from the current terminal
background and pick Claude's dark or light tokens so profile switches stay
matched.
"""
from __future__ import annotations

import argparse
import os
import re
import sys

# Cursor Agent constants.ts tints (prompt + user-message). Follow-up mixes and
# the static prompt/user fallbacks were dropped for Kitty's 7-color budget.
DARK = {
    "prompt": ("#505050", 0.95),
    "user": ("#555566", 0.82),
}
LIGHT = {
    "prompt": ("#d0d0d0", 0.90),
    "user": ("#b0b0b0", 0.82),
}

# Codex TUI style.rs user_message_bg: blend white@0.12 on dark, black@0.04 on
# light (f32 truncating `as u8`). Composer and sent messages share this fill.
CODEX_DARK_ALPHA = 0.12
CODEX_LIGHT_ALPHA = 0.04

# OpenCode theme/index.ts generateSystem (kv default theme "system"): the
# renderer background is transparent, panels paint grays[2] and the composer/
# menus paint grays[3], derived from the terminal background at startup.
OPENCODE_GRAY_SLOTS = (2, 3)
# The bundled "opencode" theme instead clears every cell with fixed steps;
# only the base background fits the remaining slot.
OPENCODE_BUNDLED_DARK = "#0a0a0a"
OPENCODE_BUNDLED_LIGHT = "#ffffff"

# Claude Code bundled theme userMessageBackground. composerSidebarBackground
# lost its slot to OpenCode's fills; auto follows colors.conf luminance.
CLAUDE_DARK = "#373737"
CLAUDE_LIGHT = "#f0f0f0"

BG_RE = re.compile(r"^background\s+(#[0-9A-Fa-f]{6})\b", re.MULTILINE)
LINE_RE = re.compile(r"^transparent_background_colors\b.*$", re.MULTILINE)
MAX_COLORS = 7


def parse_hex(value: str) -> tuple[int, int, int]:
    h = value.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def fmt_hex(rgb: tuple[int, int, int]) -> str:
    return "#{:02x}{:02x}{:02x}".format(*rgb)


def js_round(value: float) -> int:
    return int(value + 0.5) if value >= 0 else int(value - 0.5)


def luminance(rgb: tuple[int, int, int]) -> float:
    r, g, b = rgb
    return r / 255 * 0.2126 + g / 255 * 0.7152 + b / 255 * 0.0722


def mix(bg: tuple[int, int, int], tint_hex: str, mix_ratio: float) -> tuple[int, int, int]:
    tr, tg, tb = parse_hex(tint_hex)
    n = abs(luminance(bg) - 0.5) / 0.5
    adj = max(0.5, mix_ratio - 0.18 * n)
    inv = 1 - adj
    return (
        js_round(bg[0] * adj + tr * inv),
        js_round(bg[1] * adj + tg * inv),
        js_round(bg[2] * adj + tb * inv),
    )


def rust_trunc_channel(fg: int, bg: int, alpha: float) -> int:
    value = fg * alpha + bg * (1.0 - alpha)
    if value < 0:
        return 0
    if value > 255:
        return 255
    return int(value)


def rust_blend(
    fg: tuple[int, int, int], bg: tuple[int, int, int], alpha: float
) -> tuple[int, int, int]:
    return (
        rust_trunc_channel(fg[0], bg[0], alpha),
        rust_trunc_channel(fg[1], bg[1], alpha),
        rust_trunc_channel(fg[2], bg[2], alpha),
    )


def codex_is_light(bg: tuple[int, int, int]) -> bool:
    r, g, b = bg
    return 0.299 * r + 0.587 * g + 0.114 * b > 128.0


def codex_user_message_bg(bg: tuple[int, int, int]) -> tuple[int, int, int]:
    if codex_is_light(bg):
        return rust_blend((0, 0, 0), bg, CODEX_LIGHT_ALPHA)
    return rust_blend((255, 255, 255), bg, CODEX_DARK_ALPHA)


def opencode_system_gray(bg: tuple[int, int, int], slot: int, light: bool) -> tuple[int, int, int]:
    # generateGrayScale: luminance-weighted scale-up on dark (scale-down on
    # light), with flat-gray fallbacks near black/white. Math.floor rounding.
    factor = slot / 12
    lum = 0.299 * bg[0] + 0.587 * bg[1] + 0.114 * bg[2]
    if light:
        if lum > 245:
            gray = int(255 - factor * 0.4 * 255)
            return (gray, gray, gray)
        ratio = 1 - factor * 0.4
        return (int(bg[0] * ratio), int(bg[1] * ratio), int(bg[2] * ratio))
    if lum < 10:
        gray = int(factor * 0.4 * 255)
        return (gray, gray, gray)
    ratio = (lum + (255 - lum) * factor * 0.4) / lum
    return (
        int(min(bg[0] * ratio, 255)),
        int(min(bg[1] * ratio, 255)),
        int(min(bg[2] * ratio, 255)),
    )


def colors_for_background(bg_hex: str) -> list[str]:
    bg = parse_hex(bg_hex)
    light = luminance(bg) > 0.6
    primary = LIGHT if light else DARK
    ordered: list[str] = []
    seen: set[str] = set()

    def add(color: str) -> None:
        c = color.lower()
        if c not in seen:
            seen.add(c)
            ordered.append(c)

    # Current-variant Agent fills first (remix on profile/variant switch), then
    # Codex's shared composer/message pill, then OpenCode's derived system-theme
    # panel/composer fills plus its bundled base, then Claude's user-message
    # token. Agent fallbacks and Claude's sidebar token lost their slots.
    for slot in ("prompt", "user"):
        tint, ratio = primary[slot]
        add(fmt_hex(mix(bg, tint, ratio)))
    add(fmt_hex(codex_user_message_bg(bg)))
    for slot in OPENCODE_GRAY_SLOTS:
        add(fmt_hex(opencode_system_gray(bg, slot, light)))
    add(OPENCODE_BUNDLED_LIGHT if light else OPENCODE_BUNDLED_DARK)
    add(CLAUDE_LIGHT if light else CLAUDE_DARK)
    return ordered[:MAX_COLORS]


def read_background(colors_conf: str) -> str | None:
    try:
        text = open(colors_conf, encoding="utf-8").read()
    except OSError:
        return None
    match = BG_RE.search(text)
    return match.group(1) if match else None


def apply_line(kitty_conf: str, colors: list[str]) -> None:
    line = "transparent_background_colors " + " ".join(colors)
    try:
        text = open(kitty_conf, encoding="utf-8").read()
    except OSError:
        return
    if LINE_RE.search(text):
        text = LINE_RE.sub(line, text, count=1)
    elif re.search(r"^background_opacity\b", text, re.MULTILINE):
        text = re.sub(
            r"^background_opacity\b.*$",
            lambda m: m.group(0) + "\n" + line,
            text,
            count=1,
            flags=re.MULTILINE,
        )
    else:
        if text and not text.endswith("\n"):
            text += "\n"
        text += line + "\n"
    with open(kitty_conf, "w", encoding="utf-8") as fh:
        fh.write(text)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "kitty_dir",
        nargs="?",
        default=os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "kitty"),
    )
    parser.add_argument(
        "--print",
        action="store_true",
        dest="print_only",
        help="Print colors for colors.conf in kitty_dir and exit",
    )
    parser.add_argument("--background", help="Override background hex (skip colors.conf)")
    args = parser.parse_args()

    bg = args.background or read_background(os.path.join(args.kitty_dir, "colors.conf"))
    if not bg:
        return 0
    colors = colors_for_background(bg)
    if args.print_only:
        sys.stdout.write(" ".join(colors) + "\n")
        return 0
    apply_line(os.path.join(args.kitty_dir, "kitty.conf"), colors)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
