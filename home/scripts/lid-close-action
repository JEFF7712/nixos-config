#!/usr/bin/env bash
# Lid close: suspend unless the user asked to stay awake. Idle-only
# inhibitors (Firefox/Twitter autoplay, mpv, D-Bus screensaver inhibit)
# pause the idle plan while the lid is open; they must not keep the
# laptop on. Stay-awake is caffeine (Manual Pause) or Stasis
# suspend_inhibit_* matches.
set -euo pipefail

stasis_field() {
  local info="$1"
  local key="$2"
  printf '%s\n' "$info" | awk -F': *' -v key="$key" '
    $1 == key { print $2; exit }
  '
}

lid_close_should_skip_suspend() {
  local stasis_info="$1"
  local key count

  case "$(stasis_field "$stasis_info" "Manual Pause")" in
    yes) return 0 ;;
  esac

  for key in \
    "Apps Blocking Suspend" \
    "Media Players Blocking Suspend"; do
    count="$(stasis_field "$stasis_info" "$key")"
    if [[ "${count:-0}" =~ ^[1-9][0-9]*$ ]]; then
      return 0
    fi
  done
  return 1
}

if [[ "${LID_CLOSE_ACTION_LIB:-0}" == 1 ]]; then
  return 0 2>/dev/null || exit 0
fi

stasis_info="$(stasis info 2>/dev/null || true)"

if lid_close_should_skip_suspend "$stasis_info"; then
  niri msg action power-off-monitors || true
  exit 0
fi

# Suspending before the locker owns the session shows the desktop on resume,
# so confirm the lock instead of sleeping and hoping. hyprlock does not set
# logind's LockedHint, so detect it by process; the noctalia branch is an ipc
# call that exits 0 once the shell has locked. If neither lands, blank instead
# of suspending: an awake laptop is recoverable, one that resumes unlocked in
# someone else's hands is not.
/home/rupan/.local/bin/lock-screen &
lock_pid=$!

locked=false
for _ in $(seq 1 50); do
  if pgrep -x hyprlock >/dev/null 2>&1; then
    locked=true
    break
  fi
  if ! kill -0 "$lock_pid" 2>/dev/null; then
    if wait "$lock_pid"; then
      locked=true
    fi
    break
  fi
  sleep 0.1
done

if [ "$locked" != true ]; then
  printf 'lid-close-action: screen did not lock; blanking instead of suspending\n' >&2
  niri msg action power-off-monitors || true
  exit 1
fi

systemctl suspend
