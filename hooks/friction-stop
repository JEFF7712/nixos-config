#!/usr/bin/env bash
# Stop: surface session friction once. Silent if the session was clean.
set -euo pipefail
# shellcheck source=common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

agent_hooks_load || {
  printf '%s\n' '{}'
  exit 0
}

status=$(jq -r '.status // empty' <<<"$HOOK_INPUT")
if [ -n "$status" ] && [ "$status" != "completed" ]; then
  agent_hooks_ok_exit
fi

log=$(agent_hooks_friction_log "$HOOK_SESSION_ID")
fired=$(agent_hooks_friction_fired "$HOOK_SESSION_ID")

[ -s "$log" ] || agent_hooks_ok_exit
if [ -e "$fired" ]; then
  rm -f "$log"
  agent_hooks_ok_exit
fi
: >"$fired"

signals=$(sort -u "$log" | sed 's/^/  - /')
rm -f "$log"

msg="Validation friction this session in this repo:
$signals
If this exposed missing docs, a weak check, a brittle script, or unclear
validation, run agent-self-improve --check and fix the smallest agent-facing
doc/check/script before finishing. If it was just a transient mistake, ignore."

agent_hooks_emit_stop_nudge "$msg"
exit 0
