#!/usr/bin/env bash
# Record failed just/nix/nh/nixos-rebuild so friction-stop can nudge once.
# Codex PostToolUse includes successes; require a non-zero exit.
set -euo pipefail
# shellcheck source=common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

agent_hooks_load || {
  printf '%s\n' '{}'
  exit 0
}
agent_hooks_in_repo_cwd || agent_hooks_ok_exit
agent_hooks_tool_failed || agent_hooks_ok_exit

cmd=$(jq -r '.tool_input.command // empty' <<<"$HOOK_INPUT")
[ -n "$cmd" ] || agent_hooks_ok_exit
agent_hooks_is_validation_command "$cmd" || agent_hooks_ok_exit

printf '%s\n' "$(printf '%s' "$cmd" | tr '\n' ' ' | head -c 200)" \
  >>"$(agent_hooks_friction_log "$HOOK_SESSION_ID")"
agent_hooks_ok_exit
