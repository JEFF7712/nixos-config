# M6 Task 5: scripted intentd-arm pilot for the comparative baseline
# protocol (eval/baseline/PROTOCOL.md, locked decision 6). Same harness
# pattern as nix/vm-cli.nix (Task 4): drives the SHIPPED `intent` CLI
# through wiring.production_deps + apply_with_reconcile inside a nixosTest
# VM, resolver stubbed (INTENTD_RESOLVER_STUB substitutes only the
# `claude -p` subprocess; prompt construction, reply schema validation, and
# catalog-checked invocation resolution stay on the production path), build
# hermeticized via a planted flake.lock mirroring this flake's own nixpkgs
# pin (see nix/SPIKE_FINDINGS.md, "M6 Task 4 findings" for why that works
# offline).
#
# Canned resolver replies below are not invented for this file: every
# utterance is copied verbatim from eval/resolver_suite/cases.jsonl, and
# the {capability, params} pairing is exactly what eval/resolver_suite/
# report.json recorded the LIVE resolver producing for that utterance (105/
# 105 in-scope exact-match accuracy, M5). The stub only removes the
# `claude -p` network round trip from this offline VM; it does not invent a
# reply the live model hasn't already been proven to give.
#
# The six tasks run as one story against a shared workspace, each building
# on the previous task's blessed state (mirrors a single user session, and
# keeps the candidate count down):
#   1. install named free app    "install firefox"                  {} -> {firefox}
#   2. install unfree app + ack  "put obsidian on my machine"        -> {firefox, obsidian}
#   3. remove an app             "remove firefox"                    -> {obsidian}
#   4. install by description    "i need something to watch videos,
#                                  get vlc"                           -> {obsidian, vlc}
#   5. revert last change        `intent revert` (dedicated verb,
#                                  no resolver call)                  -> {obsidian}
#   6. recover from a mid-activation failure: chaos flag set, "install
#      mpv" aborts and auto-restores to {obsidian}; flag cleared, the same
#      utterance retried succeeds                                    -> {mpv, obsidian}
#
# Per-task metrics (completion, wall seconds, clarification turns, terminal
# exposure, recovery success) are collected in testScript and written to
# $out/intentd_arm.json. `out = os.environ["out"]` is the standard nixpkgs
# pattern for a nixosTest's testScript (which runs on the HOST as the
# derivation's build process) to leave a result file in the check's output
# -- see e.g. nixpkgs' nixos/tests/vlm-screenshot-question.nix for
# precedent. eval/baseline/intentd_arm.json is a checked-in copy of that
# output; PROTOCOL.md documents the copy step so reruns are reproducible.
{ self, nixpkgs }:
let
  system = "x86_64-linux";
  pkgs = nixpkgs.legacyPackages.${system};

  intentd = self.packages.${system}.intentd;
  pythonEnv = pkgs.python312.withPackages (ps: [ (ps.toPythonModule intentd) ]);
  journalKey = pkgs.writeText "intentd-journal-key" "0123456789abcdef0123456789abcdef";
  machineProfile = pkgs.writeText "intentd-vm-machine-profile.json" (
    builtins.toJSON {
      profile_id = "intentd-vm-v1";
      certified = true;
      graphics_backend = "intentd-vm";
      intel_pci = "0000:00:02.0";
      nvidia_pci = "0000:01:00.0";
      critical_units = [ "intentd-display-ready.service" ];
      display_unit = "intentd-display-ready.service";
      root_reserve_bytes = 268435456;
      esp_reserve_bytes = 134217728;
    }
  );

  scenarioBase = pkgs.writeText "base.nix" (builtins.readFile ./scenario-base.nix);

  # {firefox}: task 1 end state. Byte-identical to render() output; reuses
  # the SAME derivation as vm-cli.nix/vm-scenarios.nix (no rebuild).
  generatedFirefox = pkgs.writeText "generated.nix" (
    builtins.readFile ./scenario-generated-firefox.nix
  );

  # The remaining generated.nix variants involve obsidian (the catalog's
  # only unfree app), so render() emits an allowUnfreePredicate block too.
  # These are written INLINE (not as separate nix/*.nix files) specifically
  # so the repo's nixfmt-on-save hook never touches them: nixfmt reformats
  # real Nix syntax, and these strings must stay byte-identical to
  # intentd.render.render()'s literal output for the testScript's `diff -u`
  # assertions (and it never reformats the contents of a string literal, so
  # embedding them here is immune to that class of drift). Content verified
  # against `render()` directly before writing (see the M6 Task 5 session
  # notes in nix/SPIKE_FINDINGS.md).

  # {firefox, obsidian}: task 2 (unfree install + ack) end state.
  generatedFirefoxObsidian = pkgs.writeText "generated.nix" ''
    # Generated by intentd. Do not edit; manual changes block activation.

    { pkgs, lib, ... }:
    {
      environment.systemPackages = [
        pkgs.firefox
        pkgs.obsidian
      ];
      nixpkgs.config.allowUnfreePredicate = pkg:
        builtins.elem (lib.getName pkg) [
          "obsidian"
        ];
    }
  '';

  # {obsidian}: task 3 (remove firefox) end state; also the task 5 revert
  # target and the task 6 pre-chaos / post-abort-restore state.
  generatedObsidian = pkgs.writeText "generated.nix" ''
    # Generated by intentd. Do not edit; manual changes block activation.

    { pkgs, lib, ... }:
    {
      environment.systemPackages = [
        pkgs.obsidian
      ];
      nixpkgs.config.allowUnfreePredicate = pkg:
        builtins.elem (lib.getName pkg) [
          "obsidian"
        ];
    }
  '';

  # {obsidian, vlc}: task 4 (install by description) end state.
  generatedObsidianVlc = pkgs.writeText "generated.nix" ''
    # Generated by intentd. Do not edit; manual changes block activation.

    { pkgs, lib, ... }:
    {
      environment.systemPackages = [
        pkgs.obsidian
        pkgs.vlc
      ];
      nixpkgs.config.allowUnfreePredicate = pkg:
        builtins.elem (lib.getName pkg) [
          "obsidian"
        ];
    }
  '';

  # {mpv, obsidian}: task 6 end state, after the chaos abort + clean retry.
  generatedMpvObsidian = pkgs.writeText "generated.nix" ''
    # Generated by intentd. Do not edit; manual changes block activation.

    { pkgs, lib, ... }:
    {
      environment.systemPackages = [
        pkgs.mpv
        pkgs.obsidian
      ];
      nixpkgs.config.allowUnfreePredicate = pkg:
        builtins.elem (lib.getName pkg) [
          "obsidian"
        ];
    }
  '';

  mkCandidate =
    generated:
    (nixpkgs.lib.nixosSystem {
      system = "x86_64-linux";
      modules = [
        "${scenarioBase}"
        "${generated}"
      ];
    }).config.system.build.toplevel;

  candidateFirefox = mkCandidate generatedFirefox;
  candidateFirefoxObsidian = mkCandidate generatedFirefoxObsidian;
  candidateObsidian = mkCandidate generatedObsidian;
  candidateObsidianVlc = mkCandidate generatedObsidianVlc;
  candidateMpvObsidian = mkCandidate generatedMpvObsidian;

  # The workspace lock planted before the first `intent do`; must stay in
  # sync with this flake's own nixpkgs pin (generated from the same input,
  # so it cannot drift). Same technique as vm-cli.nix.
  workspaceLock = pkgs.writeText "flake.lock" (
    builtins.toJSON {
      nodes = {
        nixpkgs = {
          locked = {
            inherit (nixpkgs) lastModified narHash rev;
            owner = "NixOS";
            repo = "nixpkgs";
            type = "github";
          };
          original = {
            owner = "NixOS";
            ref = "nixos-unstable";
            repo = "nixpkgs";
            type = "github";
          };
        };
        root = {
          inputs.nixpkgs = "nixpkgs";
        };
      };
      root = "root";
      version = 7;
    }
  );

  # Canned resolver replies -- the model reply JSON `run_claude` would
  # return, not pre-baked Resolutions (the stub still goes through reply
  # schema validation and resolve_invocation). Each utterance below and its
  # {capability, params} is copied from eval/resolver_suite/cases.jsonl and
  # matches what eval/resolver_suite/report.json proved the live resolver
  # produces for it (M5, 105/105 in-scope exact match).
  resolverStubFirefoxInstall = pkgs.writeText "resolver-stub-firefox-install.json" (
    builtins.toJSON {
      action = "invoke";
      capability = "app.install";
      params.app = "firefox";
      reason = "canned reply for the offline vm-baseline-pilot task 1, matches the M5-proven case for this exact utterance";
    }
  );
  resolverStubObsidianInstall = pkgs.writeText "resolver-stub-obsidian-install.json" (
    builtins.toJSON {
      action = "invoke";
      capability = "app.install";
      params.app = "obsidian";
      reason = "canned reply for the offline vm-baseline-pilot task 2, matches the M5-proven case for this exact utterance";
    }
  );
  resolverStubFirefoxRemove = pkgs.writeText "resolver-stub-firefox-remove.json" (
    builtins.toJSON {
      action = "invoke";
      capability = "app.remove";
      params.app = "firefox";
      reason = "canned reply for the offline vm-baseline-pilot task 3, matches the M5-proven case for this exact utterance";
    }
  );
  resolverStubVlcInstall = pkgs.writeText "resolver-stub-vlc-install.json" (
    builtins.toJSON {
      action = "invoke";
      capability = "app.install";
      params.app = "vlc";
      reason = "canned reply for the offline vm-baseline-pilot task 4, matches the M5-proven case for this exact utterance";
    }
  );
  resolverStubMpvInstall = pkgs.writeText "resolver-stub-mpv-install.json" (
    builtins.toJSON {
      action = "invoke";
      capability = "app.install";
      params.app = "mpv";
      reason = "canned reply for the offline vm-baseline-pilot task 6, matches the M5-proven case for this exact utterance";
    }
  );

  test = pkgs.testers.runNixOSTest {
    name = "vm-baseline-pilot";

    nodes.machine =
      { lib, ... }:
      {
        system.switch.enable = true;
        environment.etc."intentd/machine-profile.json".source = machineProfile;

        virtualisation = {
          memorySize = 6144;
          cores = 4;
          diskSize = 8192;
          writableStore = true;
          additionalPaths = [
            nixpkgs.outPath
            candidateFirefox
            candidateFirefoxObsidian
            candidateObsidian
            candidateObsidianVlc
            candidateMpvObsidian
            pythonEnv
            scenarioBase
            generatedFirefox
            generatedFirefoxObsidian
            generatedObsidian
            generatedObsidianVlc
            generatedMpvObsidian
            workspaceLock
            resolverStubFirefoxInstall
            resolverStubObsidianInstall
            resolverStubFirefoxRemove
            resolverStubVlcInstall
            resolverStubMpvInstall
          ];
        };
        nix.settings = {
          experimental-features = [
            "nix-command"
            "flakes"
          ];
          substituters = lib.mkForce [ ];
          flake-registry = "";
        };
      };

    testScript = ''
      import json
      import os
      import time

      machine.start()
      machine.wait_for_unit("multi-user.target")

      machine.succeed("install -m 0600 ${journalKey} /run/intentd-journal-key")
      intent = (
          "INTENTD_JOURNAL_KEY_FILE=/run/intentd-journal-key "
          "${pythonEnv}/bin/intent --state-dir /var/lib/intentd --activate-mode test"
      )
      python = "${pythonEnv}/bin/python3"
      ws_py = "from pathlib import Path; import intentd.workspace as w; "

      metrics = []

      def record(
          task_id,
          utterance,
          capability,
          t0,
          t1,
          *,
          completion,
          invocations,
          clarification_turns=0,
          recovery_success=None,
          note=None,
      ):
          entry = {
              "id": task_id,
              "utterance": utterance,
              "capability": capability,
              "completion": completion,
              "wall_seconds": round(t1 - t0, 2),
              "clarification_turns": clarification_turns,
              "terminal_exposure_zero_construction": 0,
              "intent_invocations": invocations,
              "recovery_success": recovery_success,
          }
          if note is not None:
              entry["note"] = note
          metrics.append(entry)

      def run(cmd, expect_rc=0):
          rc, out = machine.execute(cmd)
          assert rc == expect_rc, (rc, out, cmd)
          return out

      def run_json(cmd, expect_rc=0):
          out = run(cmd, expect_rc)
          return json.loads(out.strip().splitlines()[-1])

      def profile():
          return machine.succeed("readlink -f /nix/var/nix/profiles/system").strip()

      # --- workspace setup: init the shipped template, swap in the scenario
      # base.nix (chaos unit + test instrumentation), re-baseline the
      # manifest, then plant the lock that makes the production build path
      # hermetic. None of this is part of any task's metrics. ---
      machine.succeed(f"{python} -c '{ws_py}w.init_workspace(Path(\"/var/lib/intentd/ws\"))'")
      machine.succeed("install -m 0644 ${scenarioBase} /var/lib/intentd/ws/base.nix")
      machine.succeed(f"{python} -c '{ws_py}w.repair_manifest(Path(\"/var/lib/intentd/ws\"))'")
      machine.succeed("install -m 0644 ${workspaceLock} /var/lib/intentd/ws/flake.lock")

      # --- task 1: install a named free app ---
      t0 = time.time()
      r1 = run_json(
          f"INTENTD_RESOLVER_STUB=${resolverStubFirefoxInstall} {intent} --json do 'install firefox'"
      )
      t1 = time.time()
      assert r1["outcome"] == "blessed", r1
      assert r1["added"] == ["firefox"] and r1["removed"] == [], r1
      machine.succeed("test -x /run/current-system/sw/bin/firefox")
      assert profile() == "${candidateFirefox}", profile()
      machine.succeed("diff -u ${generatedFirefox} /var/lib/intentd/ws/generated.nix")
      record(
          "install_named_free_app",
          "install firefox",
          "app.install",
          t0,
          t1,
          completion=True,
          invocations=1,
      )

      # --- task 2: install an unfree app, license ack required ---
      # `intent do --json` never prompts (a no-tty/no-prompt contract for
      # scripting): on NEEDS_ACK it returns rc 4 with required_acks and
      # stops, by design (see cli.py, cmd_do). There is no --json flag to
      # pre-supply an ack, so completing this task automatically means
      # driving the ONE path the shipped CLI offers for it: text mode with
      # the y/N prompt answered non-interactively via `echo y |`. This is a
      # real, load-bearing shape of the shipped UX, not a pilot workaround
      # invented to dodge it; PROTOCOL.md documents it as-is.
      t0 = time.time()
      out2 = run(
          "echo y | INTENTD_RESOLVER_STUB=${resolverStubObsidianInstall} "
          f"{intent} do 'put obsidian on my machine'"
      )
      t1 = time.time()
      assert "blessed" in out2 and "+obsidian" in out2, out2
      machine.succeed("test -x /run/current-system/sw/bin/obsidian")
      assert profile() == "${candidateFirefoxObsidian}", profile()
      machine.succeed("diff -u ${generatedFirefoxObsidian} /var/lib/intentd/ws/generated.nix")
      record(
          "install_unfree_app_with_license",
          "put obsidian on my machine",
          "app.install",
          t0,
          t1,
          completion=True,
          invocations=1,
          clarification_turns=1,
          note="the license ack is the one clarification turn; answered via `echo y |` in text mode, see the comment above this task in the testScript",
      )

      # --- task 3: remove an app ---
      t0 = time.time()
      r3 = run_json(
          f"INTENTD_RESOLVER_STUB=${resolverStubFirefoxRemove} {intent} --json do 'remove firefox'"
      )
      t1 = time.time()
      assert r3["outcome"] == "blessed", r3
      assert r3["removed"] == ["firefox"] and r3["added"] == [], r3
      machine.succeed("test ! -e /run/current-system/sw/bin/firefox")
      machine.succeed("test -x /run/current-system/sw/bin/obsidian")
      assert profile() == "${candidateObsidian}", profile()
      machine.succeed("diff -u ${generatedObsidian} /var/lib/intentd/ws/generated.nix")
      record(
          "remove_an_app",
          "remove firefox",
          "app.remove",
          t0,
          t1,
          completion=True,
          invocations=1,
      )

      # --- task 4: install by description (no app name in the utterance) ---
      t0 = time.time()
      r4 = run_json(
          f"INTENTD_RESOLVER_STUB=${resolverStubVlcInstall} {intent} --json do "
          "'i need something to watch videos, get vlc'"
      )
      t1 = time.time()
      assert r4["outcome"] == "blessed", r4
      assert r4["added"] == ["vlc"] and r4["removed"] == [], r4
      machine.succeed("test -x /run/current-system/sw/bin/vlc")
      assert profile() == "${candidateObsidianVlc}", profile()
      machine.succeed("diff -u ${generatedObsidianVlc} /var/lib/intentd/ws/generated.nix")
      record(
          "install_by_description",
          "i need something to watch videos, get vlc",
          "app.install",
          t0,
          t1,
          completion=True,
          invocations=1,
      )

      # --- task 5: revert the last change ---
      # `intent revert` is a dedicated verb (locked decision 3): no
      # utterance, no resolver call, deterministic.
      t0 = time.time()
      r5 = run_json(f"{intent} --json revert")
      t1 = time.time()
      assert r5["outcome"] == "blessed", r5
      assert r5["removed"] == ["vlc"] and r5["added"] == [], r5
      machine.succeed("test ! -e /run/current-system/sw/bin/vlc")
      machine.succeed("test -x /run/current-system/sw/bin/obsidian")
      assert profile() == "${candidateObsidian}", profile()
      record(
          "revert_last_change",
          None,
          "change.revert",
          t0,
          t1,
          completion=True,
          invocations=1,
          note="dedicated verb, bypasses the resolver entirely",
      )

      # --- task 6: recover from a mid-activation failure ---
      # The chaos unit (nix/scenario-base.nix, M4 Task 6 mechanism) fails
      # iff /etc/intentd-chaos exists; switch-to-configuration always
      # issues a start job for it, so every switch re-checks the flag with
      # no extra wiring. classify_switch_rc treats the resulting rc 4 as a
      # normal return (not an ExecError); the health check then sees the
      # fresh failed unit and the orchestrator aborts + auto-restores to
      # the prior blessed closure, with NO shell step the user has to run.
      machine.succeed("touch /etc/intentd-chaos")

      t0 = time.time()
      r6a = run_json(
          f"INTENTD_RESOLVER_STUB=${resolverStubMpvInstall} {intent} --json do 'install mpv'",
          expect_rc=5,
      )
      assert r6a["outcome"] == "aborted", r6a
      assert "intentd-chaos" in (r6a.get("detail") or ""), r6a

      # Restore assertions: back on the pre-failure blessed closure already,
      # before any retry -- this is the auto-restore, not the fix.
      machine.succeed("test ! -e /run/current-system/sw/bin/mpv")
      machine.succeed("test -x /run/current-system/sw/bin/obsidian")
      assert profile() == "${candidateObsidian}", profile()
      machine.succeed("diff -u ${generatedObsidian} /var/lib/intentd/ws/generated.nix")

      machine.succeed("rm /etc/intentd-chaos")

      r6b = run_json(
          f"INTENTD_RESOLVER_STUB=${resolverStubMpvInstall} {intent} --json do 'install mpv'"
      )
      t1 = time.time()
      assert r6b["outcome"] == "blessed", r6b
      assert r6b["added"] == ["mpv"] and r6b["removed"] == [], r6b
      machine.succeed("test -x /run/current-system/sw/bin/mpv")
      assert profile() == "${candidateMpvObsidian}", profile()
      machine.succeed("diff -u ${generatedMpvObsidian} /var/lib/intentd/ws/generated.nix")

      record(
          "recover_from_mid_activation_failure",
          "install mpv",
          "app.install",
          t0,
          t1,
          completion=True,
          invocations=2,
          recovery_success=True,
          note=(
              "first `do` triggers the chaos unit during switch-to-configuration; "
              "health check catches the fresh failure, the transaction is aborted "
              "and the system is auto-restored to the prior blessed closure with "
              "no user shell step; second `do` is the same utterance retried after "
              "the injected fault is cleared"
          ),
      )

      # --- write the result the check leaves behind ---
      out_dir = os.environ["out"]
      result = {
          "arm": "intentd",
          "protocol": "eval/baseline/PROTOCOL.md",
          "nixpkgs_rev": "${nixpkgs.rev}",
          "resolver": (
              "stubbed with canned replies proven by the M5 live eval "
              "(eval/resolver_suite/report.json) for these exact utterances "
              "(eval/resolver_suite/cases.jsonl); prompt construction, reply "
              "schema validation, and catalog-checked invocation resolution run "
              "on the production path, only the `claude -p` subprocess is "
              "substituted"
          ),
          "terminal_exposure_definition": (
              "terminal_exposure_zero_construction is 0 for every task by "
              "construction: the intentd arm never surfaces a raw shell command "
              "(no nix/systemctl/journalctl) to the user, only natural-language "
              "`intent do \"...\"` (or the dedicated `intent revert` verb). "
              "intent_invocations is the count of those CLI invocations needed "
              "to complete the task; it is the closest intentd-arm analogue of "
              "the baseline arm's terminal-exposure command count, and is "
              "reported alongside it rather than in place of it."
          ),
          "tasks": metrics,
          "post_failure_trust": None,
          "notes": (
              "post_failure_trust (1-5, user-scored) and the baseline arm's "
              "clarification-turn judgment are human measurements this scripted "
              "pilot cannot produce; see PROTOCOL.md."
          ),
      }
      with open(f"{out_dir}/intentd_arm.json", "w") as f:
          json.dump(result, f, indent=2)
          f.write("\n")
      print(json.dumps(result, indent=2))
    '';
  };
in
{
  inherit
    test
    candidateFirefox
    candidateFirefoxObsidian
    candidateObsidian
    candidateObsidianVlc
    candidateMpvObsidian
    pythonEnv
    workspaceLock
    ;
}
