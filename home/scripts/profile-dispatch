#!/usr/bin/env bash
# profile-dispatch <action>
# Routes profile-aware desktop actions to the right backend so niri keybinds
# stay one-liners. The noctalia bar handles these itself via `noctalia msg`;
# everything else uses the generic tools (swayosd, waypaper). Clipboard is
# identical on every profile, so both tables call the same helper rather than
# a bar-specific command (a shared case before the $BAR branch would hide it
# from the one-row-per-table convention).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

. "$SCRIPT_DIR/profile-common"

ACTIVE=$(cat "$ACTIVE_FILE" 2>/dev/null || echo "")
BAR="noctalia"
[ -n "$ACTIVE" ] && BAR=$(profile_bar "$ACTIVE")

clipboard_pick() {
  local theme selected
  theme="$HOME/.config/rofi/profile-switcher.rasi"
  selected=$(cliphist list | rofi -dmenu -i -normal-window -theme "$theme") || true
  [ -n "$selected" ] || return 0
  printf '%s\n' "$selected" | cliphist decode | wl-copy
}

# Per action: the noctalia 5.0.0 `msg` command (or a helper) and the generic
# command for every other bar. To add an action, add one row to each table; to
# add a bar backend, branch on $BAR below.
declare -A NOCTALIA=(
  [launcher]="vicinae toggle"
  # panel id unverified; needs a live test on the noctalia profile
  [wallpaper]="noctalia msg panel-toggle wallpaper"
  [volume-up]="noctalia msg volume-up"
  [volume-down]="noctalia msg volume-down"
  [volume-mute]="noctalia msg volume-mute"
  [brightness-up]="noctalia msg brightness-up"
  [brightness-down]="noctalia msg brightness-down"
  [clipboard]="clipboard_pick"
)
declare -A GENERIC=(
  [launcher]="vicinae toggle"
  [wallpaper]="waypaper"
  [volume-up]="volume-adjust up"
  [volume-down]="volume-adjust down"
  [volume-mute]="volume-adjust mute"
  [brightness-up]="swayosd-client --brightness raise --device intel_backlight"
  [brightness-down]="swayosd-client --brightness lower --device intel_backlight"
  [clipboard]="clipboard_pick"
)

ACTION="${1:-}"
if [ -z "$ACTION" ] || [ -z "${NOCTALIA[$ACTION]:-}" ]; then
  echo "Usage: profile-dispatch <$(
    IFS='|'
    echo "${!NOCTALIA[*]}"
  )>" >&2
  exit 1
fi

# Word-splitting on the table value is intentional (the commands are trusted
# constants; $REPO_HOME holds no spaces).
if [ "$BAR" = "noctalia" ]; then
  # shellcheck disable=SC2086
  ${NOCTALIA[$ACTION]}
else
  if [ "$ACTION" = "wallpaper" ]; then
    ensure_waypaper_post_command
  fi
  # shellcheck disable=SC2086
  ${GENERIC[$ACTION]}
fi
