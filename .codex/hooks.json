{
  "description": "Repo agent hooks: session context; git add/diff and switch policy; format/parse/stage after edits; nudge on validation friction.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/hooks/session-start\"",
            "timeout": 15,
            "statusMessage": "Loading agent context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/hooks/before-shell\"",
            "timeout": 5,
            "statusMessage": "Checking git add/diff policy"
          }
        ]
      },
      {
        "matcher": "mcp__nix-agent__switch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/hooks/before-mcp\"",
            "timeout": 5,
            "statusMessage": "Checking nix-agent switch policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/hooks/after-edit\"",
            "timeout": 30,
            "statusMessage": "Formatting and parse-checking edit"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/hooks/friction-log\"",
            "timeout": 5,
            "statusMessage": "Recording validation friction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/hooks/friction-stop\"",
            "timeout": 10,
            "statusMessage": "Checking session friction"
          }
        ]
      }
    ]
  }
}
